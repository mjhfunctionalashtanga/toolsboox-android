<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
          xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Play Console: firebase-analytics merges in the AD_ID permission even though collection is
         deactivated in this manifest. Ledgable never reads the advertising ID, so strip it. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <!-- Notifications are opt-in on API 33+; without this declaration a future notify() would
         throw rather than ask. All posting funnels through ot/LedgerNotifications, which checks
         the runtime grant and degrades to silence. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The playback anchor: audio must survive backgrounding (08-30). mediaPlayback-typed
         foreground service; the WAKE_LOCK rides MediaPlayer.setWakeMode. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>

    <!-- "via EinkBro" on a shared pick: the sender's package comes from the referrer, its NAME
         needs visibility on Android 11+. A short named list, never QUERY_ALL_PACKAGES (Play
         policy; Ledgable is in a closed test) — ShareActions.viaName has a fallback table. -->
    <queries>
        <package android:name="info.plateaukao.einkbro"/>
        <package android:name="info.plateaukao.einkbro.g"/>  <!-- the Play edition on his B6 -->
        <package android:name="com.android.chrome"/>
        <package android:name="com.onyx.kreader"/>
        <package android:name="org.koreader.launcher"/>
        <package android:name="com.google.android.gm"/>
    </queries>

    <application
            android:name=".ui.BaseApplication"
            android:allowBackup="true"
            android:fullBackupContent="@xml/backup_content"
            android:dataExtractionRules="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/App.Theme"
            android:requestLegacyExternalStorage="true">

        <!-- Disable default WorkManager initializer; BaseApplication provides custom config -->
        <provider
                android:name="androidx.startup.InitializationProvider"
                android:authorities="${applicationId}.androidx-startup"
                android:exported="false"
                tools:node="merge">
            <meta-data
                    android:name="androidx.work.WorkManagerInitializer"
                    android:value="androidx.startup"
                    tools:node="remove"/>
        </provider>

        <meta-data
                android:name="firebase_analytics_collection_deactivated"
                android:value="true"/>

        <!-- Camera capture target for the long-press "Image — camera" flow. -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <!--
            THE GYRO FOLLOWS THE DEVICE. Michael, 2026-08-04: "gyro is unreliable" — and on
            2026-08-05, that it "doesn't follow". It could not: `sensorPortrait` (inherited from
            upstream toolsbooX, along with the lint suppression that acknowledged it) rotates only
            between portrait and upside-down. Landscape was never on offer, so turning the tablet
            sideways did nothing and read as a flaky sensor rather than a locked window.

            `fullUser` follows the sensor through all four orientations AND obeys the device's own
            rotation lock — so this gives the rotation back without taking away the ability to pin
            it, which on a device you write on lying down is not a small thing.

            The activity already declares `orientation|screenSize|screenLayout` in configChanges,
            so it re-lays out in place rather than being recreated: a rotation mid-stroke does not
            restart the fragment or drop the page.
        -->
        <activity
                android:name=".ui.main.MainActivity"
                android:screenOrientation="fullUser"
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
                android:enableOnBackInvokedCallback="true"
        android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="https"/>
                <data android:host="app.toolsboox.com"/>
                <data android:scheme="toolsboox"/>
                <data android:host="app"/>
            </intent-filter>
            <!-- The pairing string: ledgable://pair?site=…&user=…&pass=… from ledgable.cc/pair
                 (and the plugin's wizard). One tap adds the site and its application password. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ledgable"/>
                <data android:host="pair"/>
            </intent-filter>
            <!-- Open-with-Ledgable (09-03: "make sure ledgable accepts mail urls and web urls
                 etc as ways to open them"): mailto: opens the composer prefilled; a web link
                 offers the Web room / keep chooser. Ledgable joins the system chooser — it
                 never claims default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mailto"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
            </intent-filter>
            <!-- The three SEND filters MOVED to ShareCatchActivity below (2026-10-10). The card's
                 ⋯ More reaches MainActivity inside a launcher-shaped intent (never a SEND root).
                 EinkBro's remembered "share to last target" (which stores this component) still
                 arrives on Android 12 and below and is forwarded to the card; from Android 13 an
                 explicit intent must match a filter here, so the system drops it before delivery
                 (EinkBro should fall back to its chooser, where Ledgable is the card — field-check)
                 — see forwardForeignShare. -->
        </activity>

        <!--
            SEND FROM ANY APP — the card (Michael, 2026-10-10: "highlight text, or pick an image, in
            EinkBro or any other app. A small Ledgable card appears over that app. One tap saves
            it, and you're back in EinkBro."). Translucent and floating over the sender, inside the
            sender's task: excludeFromRecents + noHistory + an empty taskAffinity keep it out of
            recents, out of the back stack, and off Ledgable's own task (a NEW_TASK share would
            otherwise surface the day page behind it). EinkBro's highlight menu lists it by this
            label and icon.

            ALL THREE SEND filters live here, not split with MainActivity: EinkBro's last-target
            shortcut sends to the OTHER activity when a package has two that accept text
            (IntentUnit.resolveBestActivityClass). PROCESS_TEXT is the selection-menu door. One
            entry, not two (a 1-tap "◈ Pick" alias would sit in every app's selection menu —
            Michael, decision 1: "As you like").
        -->
        <activity
                android:name=".ui.share.ShareCatchActivity"
                android:label="@string/ledger_share_target_title"
                android:theme="@style/Ledger.ShareCatch"
                android:exported="true"
                android:excludeFromRecents="true"
                android:noHistory="true"
                android:taskAffinity=""
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
                android:enableOnBackInvokedCallback="true">
            <intent-filter android:label="@string/ledger_share_target_title">
                <action android:name="android.intent.action.PROCESS_TEXT"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Share-to-Ledgable (text): the fork chrome offers ⏳ Later first, then the gram
                 lane and the text-box rows. One share identity: "Ledgable" — he says Ledgable. -->
            <intent-filter android:label="@string/ledger_share_target_title">
                <action android:name="android.intent.action.SEND"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Share-to-Ledger target: share an image from any app onto today's day page. -->
            <intent-filter android:label="@string/ledger_share_target_title">
                <action android:name="android.intent.action.SEND"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- Share-to-Ledger target: a PDF shared from any app lands on the bookshelf.
                 Without this filter the share sheet never offered Ledger for a PDF at all
                 ("PDFs won't import", 08-17 queue) — text and images were the only doors. -->
            <intent-filter android:label="@string/ledger_share_target_title">
                <action android:name="android.intent.action.SEND"/>

                <category android:name="android.intent.category.DEFAULT"/>

                <data android:mimeType="application/pdf"/>
            </intent-filter>
        </activity>
        <receiver
                android:name=".plugin.calendar.widget.CalendarWidgetProvider"
                android:label="@string/widget_full_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/calendar_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.ScheduleWidgetProvider"
                android:label="@string/widget_schedule_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/schedule_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.TasksNotesWidgetProvider"
                android:label="@string/widget_tasks_notes_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/tasks_notes_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.MailWidgetProvider"
                android:label="@string/widget_mail_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/mail_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.BlogWidgetProvider"
                android:label="@string/widget_blog_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/blog_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.RosterWidgetProvider"
                android:label="@string/widget_roster_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/roster_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.FeedWidgetProvider"
                android:label="@string/widget_feed_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/feed_widget_info"/>
        </receiver>

        <!-- The scrollable Feed List widget: a separate provider so the bitmap Feed widget
             above keeps its identity and nothing already placed on a home screen changes. -->
        <receiver
                android:name=".plugin.calendar.widget.FeedListWidgetProvider"
                android:label="@string/widget_feed_list_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/feed_list_widget_info"/>
        </receiver>

        <!-- The playback lifecycle anchor — foreground only while real audio plays. -->
        <service
                android:name=".ui.plugin.LedgerPlayerService"
                android:foregroundServiceType="mediaPlayback"
                android:exported="false"/>

        <!-- The Feed List widget's row factory. BIND_REMOTEVIEWS keeps it launcher-only. -->
        <service
                android:name=".plugin.calendar.widget.FeedListWidgetService"
                android:permission="android.permission.BIND_REMOTEVIEWS"
                android:exported="false"/>

        <!-- The scrollable Mail List widget — the Feed List pattern over the inbox. A separate
             provider so the bitmap Mail widget above keeps its identity. -->
        <receiver
                android:name=".plugin.calendar.widget.MailListWidgetProvider"
                android:label="@string/widget_mail_list_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/mail_list_widget_info"/>
        </receiver>

        <service
                android:name=".plugin.calendar.widget.MailListWidgetService"
                android:permission="android.permission.BIND_REMOTEVIEWS"
                android:exported="false"/>

        <!-- The scrollable Task Checklist widget — per-row ✓ checkboxes that mark done from the
             home screen. A separate provider so the bitmap Task List widget keeps its identity. -->
        <receiver
                android:name=".plugin.calendar.widget.DoorsWidgetProvider"
                android:label="@string/widget_doors_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/doors_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.TaskChecklistWidgetProvider"
                android:label="@string/widget_task_check_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/task_check_widget_info"/>
        </receiver>

        <service
                android:name=".plugin.calendar.widget.TaskChecklistWidgetService"
                android:permission="android.permission.BIND_REMOTEVIEWS"
                android:exported="false"/>

        <!-- The Task Checklist's row receiver (✓ marks done / row opens its day). Not exported:
             only this app's own PendingIntent template addresses it, explicitly. -->
        <receiver
                android:name=".plugin.calendar.widget.TaskDoneReceiver"
                android:exported="false"/>

        <receiver
                android:name=".plugin.calendar.widget.TaskListWidgetProvider"
                android:label="@string/widget_task_list_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/task_list_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.AllStarsWidgetProvider"
                android:label="@string/widget_all_stars_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/all_stars_widget_info"/>
        </receiver>

        <receiver
                android:name=".plugin.calendar.widget.DailyPileWidgetProvider"
                android:label="@string/widget_daily_pile_label"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.toolsboox.widget.ACTION_REFRESH"/>
            </intent-filter>

            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/daily_pile_widget_info"/>
        </receiver>

    </application>
</manifest>
