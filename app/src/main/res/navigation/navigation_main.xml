    <!-- Roots · Seeds · Sprouts are RETIRED destinations (2026-08). All three were DERIVED views
         over material that lives elsewhere — they owned no data of their own — and the measured
         record said so: Michael called Roots and Seeds "pretty useless". Quick Wins and Missed
         Connections ("pretty good") both stay. -->

    <action
            android:id="@+id/action_to_quick_wins"
            app:destination="@id/QuickWinsFragment"/>

    <!-- "Missed Connections" to the reader; MissedRhizomes to the compiler. The internal vocabulary
         stays "rhizome" on purpose: the class, the file, the nav ids and the stored keys are wired
         through the rhizome graph, and renaming them would be churn with no benefit and a real risk
         of cutting a live wire. Only what he SEES changes. -->
    <action
            android:id="@+id/action_to_missed_rhizomes"
            app:destination="@id/MissedRhizomesFragment"/>

