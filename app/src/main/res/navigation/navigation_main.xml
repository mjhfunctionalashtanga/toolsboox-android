    <!-- The Scratch destination is RETIRED. It was never a page of its own — it was an alias of the
         day-note surface that existed so Back would pop it, and so the floating pen button could ask
         "am I standing on my note right now?" by reading the destination id. Both jobs now go
         through the ordinary day destination: the pen button asks the fragment itself
         (CalendarDayFragment.currentNotePage()), which is the same LIVE question with one fewer
         phantom surface in the vocabulary. -->

    <action
            android:id="@+id/action_to_settings"
            app:destination="@id/CalendarSettingsFragment"/>

