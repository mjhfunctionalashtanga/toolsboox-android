<resources>
    <!--
        Large e-ink panels: Boox Note (1404x1872 @300dpi -> ~749dp) and Tab X (1650x2200 @212dpi
        -> ~1245dp). Both draw the page at roughly 1.1x where a Palma draws it at 0.59x, so the
        furniture needs to grow with it or it reads as a phone's controls stranded on a desk-sized
        page.

        1.6x, which lands a pill button at about 98px on a Tab X against the Palma's 120px — close
        enough to feel like the same app, without the pills eating a page that finally has room.
    -->
    <dimen name="ledger_toolbar_width">64dp</dimen>
    <dimen name="ledger_toolbar_button">64dp</dimen>
    <dimen name="ledger_pill_button">74dp</dimen>
    <dimen name="ledger_pill_button_padding">14dp</dimen>
    <dimen name="ledger_grip_short">35dp</dimen>
    <dimen name="ledger_grip_long">74dp</dimen>
    <dimen name="ledger_navigator_height">76dp</dimen>
    <dimen name="ledger_nav_button">70dp</dimen>
</resources>
