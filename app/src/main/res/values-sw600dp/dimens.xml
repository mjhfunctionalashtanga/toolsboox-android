<resources>
    <!--
        Mid-size e-ink panels — the Tab Mini C (1404x1872 @300dpi -> ~749dp) lands HERE, not in
        the big-panel bucket: its high dpi makes a dp physically large, so the old shared 1.6x
        set put 139px pill buttons on a 7.8" screen ("shrink the hamburger itself" - Michael,
        on device). Near-base sizes read right at this density; the 13" set lives in sw900dp.
    -->
    <dimen name="ledger_toolbar_width">44dp</dimen>
    <dimen name="ledger_toolbar_button">44dp</dimen>
    <!-- Day-page pills hardcode a 30dp button (tightened on-device), and the grip's long side
         must EQUAL the button or it renders wider than the icon and sits uncentered on the Tab —
         so this whole set matches the base 30/18 grip. "Near-base sizes read right at this
         density" (above); the old 45s put a 45·scale grip beside a 30·scale button. -->
    <dimen name="ledger_pill_button">30dp</dimen>
    <dimen name="ledger_pill_button_padding">7dp</dimen>
    <dimen name="ledger_grip_short">18dp</dimen>
    <dimen name="ledger_grip_long">30dp</dimen>
    <dimen name="ledger_navigator_height">60dp</dimen>
    <dimen name="ledger_nav_button">44dp</dimen>
</resources>
