<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:paddingEnd="12dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/entry_title"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Star lives INLINE on the meta line (not its own full-height column), so the title
             and thumbnail get the row's width back. Visually small; the adapter widens its
             touch target to ~44dp with a TouchDelegate. -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/entry_star"
                android:text="☆"
                android:textColor="#000000"
                android:textSize="15sp"
                android:paddingEnd="8dp"
                android:paddingVertical="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/entry_meta"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/entry_blurb"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:textColor="#444444"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/entry_image"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null"
        android:layout_gravity="center_vertical"/>
</LinearLayout>
