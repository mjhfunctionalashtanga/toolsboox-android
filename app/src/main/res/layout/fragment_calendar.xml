<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"

        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:id="@+id/mainProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-7dp"
            android:indeterminate="true"
            android:visibility="invisible"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:visibility="visible"/>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/drawing_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"

            app:layout_constraintTop_toBottomOf="@id/mainProgress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/navigatorImageView"
                android:layout_width="0dp"
                android:layout_height="@dimen/ledger_navigator_height"
                android:scaleType="fitXY"
                android:contentDescription="@string/calendar_navigator_image"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

        <!-- iPad-style jump buttons by the carets: left = apps/almanac, right = sections.
             Hidden by default; only the day page turns them on. -->
        <ImageButton
                android:id="@+id/goAppsButton"
                android:layout_width="@dimen/ledger_nav_button"
                android:layout_height="@dimen/ledger_nav_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bar_sections"
                android:background="#FFFFFF"
                android:contentDescription="@string/go_to_title"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="@id/navigatorImageView"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="4dp"/>

    <!-- The making surface's DIRECTORY, as a small bar under the date strip: it names the board
         or page you're standing in, and opening it lists this surface's others on this day, a way
         to start another, and the way to the same surface on a different day. The iPad grew this
         first (a chip in the strip under its almanac bar); this is its Boox half, so learning it
         once is learning it everywhere.

         Overlaid via constraints to the strip — NOT inserted into the layout flow — for the same
         reason goAppsButton is: the canvas below draws in a fixed 1404-wide design space, and a
         view that pushed it down would put every template's geometry out by the height of this
         bar. Hidden by default; only the surfaces that accumulate pages turn it on. -->
    <TextView
            android:id="@+id/directoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="#FF000000"
            android:background="@drawable/dialog_rounded_bg"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
            app:layout_constraintStart_toStartOf="@id/navigatorImageView"/>

        <!-- Floating nav widget (day page only): ‹ prev-date · ↑↓ sections · next-date ›.
             Overlays the page (does not shift it). Hidden by default. -->
        <LinearLayout
                android:id="@+id/navWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ledger_bar_bg"
                android:padding="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/navigatorImageView"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp">

            <ImageView android:id="@+id/navGrip" android:layout_width="@dimen/ledger_grip_short" android:layout_height="30dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_grip"
                android:contentDescription="@null"/>
            <ImageButton android:id="@+id/navUp" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_group_day"/>
            <ImageButton android:id="@+id/navGoto" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_today"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
            <ImageButton android:id="@+id/navDown" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_group_day"/>
            <ImageButton android:id="@+id/navExpand" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_nav_left"
                android:contentDescription="@null"/>
            <!-- Retired from the nav pill (kept hidden so code refs/tests survive): date
                 arrows live on the top bar now; the wrench moved to the tool pill. -->
            <ImageButton android:id="@+id/navLeft" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_nav_left"
                android:contentDescription="@null"/>
            <ImageButton android:id="@+id/navRight" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_nav_right"
                android:contentDescription="@null"/>
            <ImageButton android:id="@+id/navGear" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" app:srcCompat="@drawable/ic_wrench"
                android:contentDescription="@null"/>
        </LinearLayout>

        <!-- Floating tool selector (day page only): pen · eraser · lasso · undo · redo.
             Overlays the page; each button drives the real (hidden) toolbar action so the
             Onyx ink wiring is unchanged. Hidden by default. -->
        <LinearLayout
                android:id="@+id/toolWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ledger_bar_bg"
                android:padding="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/navigatorImageView"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="18dp">

            <ImageView android:id="@+id/toolGrip" android:layout_width="@dimen/ledger_grip_short" android:layout_height="30dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_grip"
                android:contentDescription="@null"/>
            <ImageButton android:id="@+id/toolPen" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="4dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_pen"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_pen"/>
            <ImageButton android:id="@+id/toolEraser" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="4dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_eraser"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_eraser"/>
            <ImageButton android:id="@+id/toolLasso" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="4dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_lasso"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_lasso"/>
            <ImageButton android:id="@+id/toolUndo" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="4dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_undo"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Undo"/>
            <ImageButton android:id="@+id/toolRedo" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="4dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_redo"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Redo"/>
            <ImageButton android:id="@+id/toolGear" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="7dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_wrench"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_settings"/>
            <ImageButton android:id="@+id/toolExpand" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" android:src="@drawable/ic_nav_left"
                android:contentDescription="@null"/>
        </LinearLayout>

        <include
                layout="@layout/toolbar_drawing"
                android:id="@+id/toolbarDrawing"
                android:layout_width="@dimen/ledger_toolbar_width"
                android:layout_height="match_parent"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/templateImageView"/>

        <ImageView
                android:id="@+id/templateImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/calendar_template_image"

                app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

        <SurfaceView
                android:id="@+id/surfaceView"
                android:layout_width="0dp"
                android:layout_height="0dp"

                app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Numbered-notes pager: ‹  page N  › at the top of the paper (numeric notePage
             only). Swipes are two-finger-gated over ink, so the numbered pages were stepped
             blind; the arrows reuse the section stepper's actions and tapping the number
             opens the jump picker. Declared after the surface (draw order), and like the
             spiral line it must ALSO be described in CalendarUtils' cloned ConstraintSet or
             it comes back 0×0. Gone by default; only numeric pages turn it on. -->
        <LinearLayout
                android:id="@+id/notePager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="0dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="150dp"
                android:layout_marginTop="2dp">

            <ImageButton android:id="@+id/notePagerPrev" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_left"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/toolbar_previous_image"/>
            <TextView android:id="@+id/notePagerLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="6dp" android:textColor="#000000" android:textSize="13sp"
                android:fontFamily="@font/atkinson_hyperlegible"/>
            <ImageButton android:id="@+id/notePagerNext" android:layout_width="30dp" android:layout_height="30dp"
                android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_right"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/toolbar_next_image"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
