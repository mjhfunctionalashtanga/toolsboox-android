<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"

        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:id="@+id/mainProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-7dp"
            android:indeterminate="true"
            android:visibility="invisible"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:visibility="visible"/>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/drawing_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"

            app:layout_constraintTop_toBottomOf="@id/mainProgress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/navigatorImageView"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/calendar_navigator_image"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

        <!-- iPad-style jump buttons by the carets: left = apps/almanac, right = sections.
             Hidden by default; only the day page turns them on. -->
        <ImageButton
                android:id="@+id/goAppsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bar_sections"
                android:background="#FFFFFF"
                android:contentDescription="@string/go_to_title"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="@id/navigatorImageView"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="4dp"/>

        <ImageButton
                android:id="@+id/goSectionsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bar_sections"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/go_group_day"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="@id/navigatorImageView"
                app:layout_constraintEnd_toEndOf="@id/navigatorImageView"
                android:layout_marginEnd="2dp"/>

        <!-- Floating nav widget (day page only): ‹ prev-date · ↑↓ sections · next-date ›.
             Overlays the page (does not shift it). Hidden by default. -->
        <LinearLayout
                android:id="@+id/navWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ledger_bar_bg"
                android:padding="4dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/navigatorImageView"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp">

            <ImageView android:id="@+id/navGrip" android:layout_width="22dp" android:layout_height="46dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_grip"
                android:contentDescription="@null"/>
            <TextView android:id="@+id/navGoto" android:layout_width="46dp" android:layout_height="46dp"
                android:gravity="center" android:textSize="22sp" android:text="☀️"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
            <ImageButton android:id="@+id/navLeft" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_left"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
            <ImageButton android:id="@+id/navUp" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_group_day"/>
            <ImageButton android:id="@+id/navDown" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_group_day"/>
            <ImageButton android:id="@+id/navRight" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_right"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
            <ImageButton android:id="@+id/navGear" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="10dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_settings"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_settings"/>
        </LinearLayout>

        <!-- Floating tool selector (day page only): pen · eraser · lasso · undo · redo.
             Overlays the page; each button drives the real (hidden) toolbar action so the
             Onyx ink wiring is unchanged. Hidden by default. -->
        <LinearLayout
                android:id="@+id/toolWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ledger_bar_bg"
                android:padding="4dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/navigatorImageView"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="18dp">

            <ImageView android:id="@+id/toolGrip" android:layout_width="22dp" android:layout_height="46dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_grip"
                android:contentDescription="@null"/>
            <ImageButton android:id="@+id/toolPen" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="8dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_pen"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_pen"/>
            <ImageButton android:id="@+id/toolEraser" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="8dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_eraser"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_eraser"/>
            <ImageButton android:id="@+id/toolLasso" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="8dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_lasso"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/calendar_drawing_toolbar_lasso"/>
            <ImageButton android:id="@+id/toolUndo" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="8dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_undo"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Undo"/>
            <ImageButton android:id="@+id/toolRedo" android:layout_width="46dp" android:layout_height="46dp"
                android:padding="8dp" android:scaleType="fitCenter" app:srcCompat="@drawable/ic_toolbar_redo"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Redo"/>
        </LinearLayout>

        <include
                layout="@layout/toolbar_drawing"
                android:id="@+id/toolbarDrawing"
                android:layout_width="40dp"
                android:layout_height="match_parent"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/templateImageView"/>

        <ImageView
                android:id="@+id/templateImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/calendar_template_image"

                app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

        <SurfaceView
                android:id="@+id/surfaceView"
                android:layout_width="0dp"
                android:layout_height="0dp"

                app:layout_constraintTop_toBottomOf="@id/navigatorImageView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbarDrawing"
                app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
