<?xml version="1.0" encoding="utf-8"?>
<!-- Notes & Annotations — the day/week/… log of book highlights + starred articles
     (CalendarDay.readingEvents), mirroring the iPad ReadingTimelineView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Title row -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <TextView
            android:text="@string/reading_log_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/origin_button"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="15sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/goto_button"
            style="?android:attr/borderlessButtonStyle"
            android:text="☰"
            android:textSize="20sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Almanac-style period nav bar: ‹ prev · period title · next › · level. -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/prev_button"
            style="?android:attr/borderlessButtonStyle"
            android:text="‹" android:textSize="26sp"
            android:minWidth="0dp" android:paddingHorizontal="14dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/period_title"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="#000000"
            android:maxLines="1" android:ellipsize="end"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/next_button"
            style="?android:attr/borderlessButtonStyle"
            android:text="›" android:textSize="26sp"
            android:minWidth="0dp" android:paddingHorizontal="14dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/range_button"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="15sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
            android:layout_marginStart="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/reading_log_empty"
        android:textColor="#666666"
        android:textSize="16sp"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reading_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
