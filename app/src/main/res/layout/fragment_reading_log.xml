<?xml version="1.0" encoding="utf-8"?>
<!-- Notes & Annotations — the day/week/… log of book highlights + starred articles
     (CalendarDay.readingEvents), mirroring the iPad ReadingTimelineView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Title row -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <TextView
            android:text="@string/reading_log_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/origin_button"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="15sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/gram_button"
            android:src="@drawable/ic_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/gram_capture_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <ImageButton
            android:id="@+id/goto_button"
            android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
    </LinearLayout>

    <!-- Almanac-style level ladder: Day · Week · Month · Quarter · Year · All (built in code). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp">
        <LinearLayout
            android:id="@+id/level_row"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- Period pager: ‹ prev · period title · next › -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/prev_button"
            android:src="@drawable/ic_nav_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="8dp"
            android:contentDescription="@string/reader_prev"
            android:layout_width="40dp" android:layout_height="40dp"/>
        <TextView
            android:id="@+id/period_title"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="#000000"
            android:maxLines="1" android:ellipsize="end"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/next_button"
            android:src="@drawable/ic_nav_right"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="8dp"
            android:contentDescription="@string/reader_next"
            android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/reading_log_empty"
        android:textColor="#666666"
        android:textSize="16sp"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reading_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
