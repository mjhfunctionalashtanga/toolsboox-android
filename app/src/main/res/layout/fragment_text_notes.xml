<?xml version="1.0" encoding="utf-8"?>
<!-- Text Notes — multiple titled notes per day (Simplenote-style, instantly saved).

     A horizontal row so the tucked action rail sits IN THE LAYOUT FLOW beside the note — the
     editor ends where the rail begins. The gutter is authored on the start edge;
     setupActionRail re-docks it when the shared side pref says RIGHT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_notes_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<LinearLayout
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/text_notes_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="☰"
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:background="@drawable/eink_press_bg"/>

        <Button
            android:id="@+id/text_notes_prev"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:text="‹"
            android:textSize="22sp"
            android:textColor="@android:color/black"
            android:background="@drawable/eink_press_bg"/>

        <TextView
            android:id="@+id/text_notes_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#666666"/>

        <Button
            android:id="@+id/text_notes_next"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@android:color/black"
            android:background="@drawable/eink_press_bg"/>

        <Button
            android:id="@+id/text_notes_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡ Notes"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground"/>

        <Button
            android:id="@+id/text_notes_preview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="👁"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:background="@drawable/eink_press_bg"/>

        <Button
            android:id="@+id/text_notes_new"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="＋"
            android:textSize="22sp"
            android:textColor="@android:color/black"
            android:background="@drawable/eink_press_bg"/>
    </LinearLayout>

    <!-- The real Almanac strip, same as Mail and the Feed: notes are day-anchored, so the strip
         travels between days (arrows step; a period tap retunes the arrows' stride). fitXY so the
         1404-wide bitmap spans the view and the touch map lands on the drawn slots. -->
    <ImageView
        android:id="@+id/text_notes_navigator"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <EditText
        android:id="@+id/text_notes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:inputType="textCapSentences"
        android:hint="Title"
        android:importantForAutofill="no"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"/>

    <EditText
        android:id="@+id/text_notes_edit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:padding="20dp"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
        android:hint="Write anything…"
        android:importantForAutofill="no"/>

    <!-- Rendered markdown, shown in place of the editor when preview is on. -->
    <ScrollView
        android:id="@+id/text_notes_preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:scrollbars="none">

        <TextView
            android:id="@+id/text_notes_render"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@android:color/black"
            android:textIsSelectable="true"/>
    </ScrollView>

    <!-- Bridged ink: the stroke PNGs a /notes reproduction of a Boox note carries (the note's
         additive "images" refs). GONE for every note without them — the layout is then exactly
         what it always was. When present it splits the column with whichever text surface is
         up (editor or preview), both weight-1 siblings. -->
    <ScrollView
        android:id="@+id/text_notes_images_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/text_notes_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"/>
    </ScrollView>
</LinearLayout>

</LinearLayout>
