<?xml version="1.0" encoding="utf-8"?>
<!-- One object's rhizome: everything it joins, reachable from the object itself.

     A page rather than a dialog, for the same reason the roots are a page — this is something you
     read and follow, and every card on it is a door to another object whose own rhizome you may
     then want. A dialog stack cannot be walked; a page can be arrived at, lingered on and left,
     and Back steps through where you have been. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/rhizome_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/rhizome_close"
            android:text="@string/roots_close"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/rhizome_subject"
        android:textSize="13sp"
        android:textColor="#666666"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:id="@+id/rhizome_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rhizome_column"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
