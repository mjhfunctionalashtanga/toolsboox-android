<?xml version="1.0" encoding="utf-8"?>
<!-- NO fitsSystemWindows here: it honoured all four sides, and in landscape the navigation
     bar is a SIDE inset — every non-ink surface kept a dead band past the rail. The window
     is edge-to-edge and MainActivity's insets listener pads top/bottom back selectively. -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"

        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:id="@+id/mainContentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <include
                android:id="@+id/mainToolbar"
                layout="@layout/toolbar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"/>

        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragmentContent"

                    android:name="androidx.navigation.fragment.NavHostFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    app:defaultNavHost="true"
                    app:navGraph="@navigation/navigation_main"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

            <!-- THE BOTTOM PILL (Michael 2026-10-11: "more of an oblong than a circle"), on every
                 screen: [corner | notes]. The corner half is GONE until an ink page lends it
                 (BottomPill.Corner); alone, the notes half is the round notes button it was. -->
            <LinearLayout
                    android:id="@+id/floatNotePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bottom_pill_bg"
                    android:elevation="0dp">

                <ImageButton
                        android:id="@+id/floatCornerButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_fullscreen"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@android:color/transparent"
                        android:contentDescription="Full screen"
                        android:visibility="gone"/>

                <View
                        android:id="@+id/floatNoteDivider"
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#000000"
                        android:visibility="gone"/>

                <!-- Global "pull up a scratch ink surface" button, on every screen. -->
                <ImageButton
                        android:id="@+id/floatNoteButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_pencil"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@android:color/transparent"
                        android:contentDescription="Notes"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
