<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Almanac nav row FIRST: a ☰ main-menu next to the left carat, the date-filter strip, and
         the ✕ close. The "Mail" title is gone — the strip is the header. The navigator keeps its
         fitXY full width of THIS row; CalendarNavBarHost maps taps by the view's own width
         (px = x * 1404 / view.width), so sharing the row with the ☰/✕ doesn't shift the slots. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/mail_menu"
            android:text="☰"
            android:textSize="22sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/mail_navigator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginHorizontal="4dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>

        <!-- Hide-nav toggle: collapses the almanac strip out of this row to reclaim the band; the
             chevron flips to ⌄ and is the affordance that brings it back. Shares the "ledger_ui"
             prefs with the day page's toggle, so hiding it in one place holds in the other. -->
        <TextView
            android:id="@+id/mail_nav_hide"
            android:text="⌃"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_close"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Search line BENEATH the almanac (Michael's layout): the field takes the row, and the sweep
         (🧹), accounts-gear (⚙) and refresh (⟳) ride at its right — the actions that used to sit up
         in the removed title bar. Submit (⏎) filters the LOADED mail (fetch window + starred pile);
         a row under those results offers the same query to the servers (IMAP SEARCH). ✕ clears. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="10dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/mail_search_field"
            android:hint="Search mail…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="16sp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_search_clear"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#000000"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_clear"
            android:text="🧹"
            android:textSize="20sp"
            android:textColor="#000000"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_settings"
            android:text="⚙"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_refresh"
            android:text="⟳"
            android:textSize="22sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <!-- The state chips: To-dos / All, the per-account filter, and (when the strip is off today)
         the active window — solid black when selected, because gray washes vanish on e-ink. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mail_chips"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- The ✉ All chip's dropdown: the configured accounts, one row each, in the same accordion
         idiom as the rest of the app (▸/▾ on the header, indented children, accent outline).
         Tap the chip → unified inbox AND this list; tap an account → just that inbox. -->
    <LinearLayout
        android:id="@+id/mail_accounts"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/mail_status"
        android:text="Fetching…"
        android:visibility="gone"
        android:textColor="#666666"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mail_container"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
