<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/mail_title"
            android:text="Mail"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/mail_clear"
            android:text="🧹"
            android:textSize="20sp"
            android:textColor="#000000"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_settings"
            android:text="⚙"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_refresh"
            android:text="⟳"
            android:textSize="22sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_close"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <!-- Search — one field, two layers (the Reading Log's field-plus-button row): submit (⏎)
         filters the LOADED mail (fetch window + starred pile); a row under those results offers
         the same query to the servers (IMAP SEARCH). On-submit rather than per-keystroke — e-ink
         pays a full redraw for every filter pass. ✕ clears back to the normal inbox. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/mail_search_field"
            android:hint="Search mail…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="16sp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_search_clear"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#000000"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- The real Almanac strip: filter the inbox by date exactly as the feed filters articles. Today
         (day) is the live view (all mail); step or pick a period to see just that window's mail.
         fitXY, like Tasks & Events: the strip's touch map assumes the 1404-wide bitmap spans the
         whole view — the default fitCenter letterboxed it, so taps landed on the wrong slots. -->
    <ImageView
        android:id="@+id/mail_navigator"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <!-- The state chips: To-dos / All, the per-account filter, and (when the strip is off today)
         the active window — solid black when selected, because gray washes vanish on e-ink. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mail_chips"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- The ✉ All chip's dropdown: the configured accounts, one row each, in the same accordion
         idiom as the rest of the app (▸/▾ on the header, indented children, accent outline).
         Tap the chip → unified inbox AND this list; tap an account → just that inbox. -->
    <LinearLayout
        android:id="@+id/mail_accounts"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/mail_status"
        android:text="Fetching…"
        android:visibility="gone"
        android:textColor="#666666"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mail_container"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
