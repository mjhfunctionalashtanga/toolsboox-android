<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/mail_title"
            android:text="Mail"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/mail_toggle"
            android:text="★ To-dos"
            android:textSize="15sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_clear"
            android:text="🧹"
            android:textSize="20sp"
            android:textColor="#000000"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_settings"
            android:text="⚙"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_refresh"
            android:text="⟳"
            android:textSize="22sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/mail_close"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <!-- The real Almanac strip: filter the inbox by date exactly as the feed filters articles. Today
         (day) is the live view (all mail); step or pick a period to see just that window's mail. -->
    <ImageView
        android:id="@+id/mail_navigator"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/mail_status"
        android:text="Fetching…"
        android:visibility="gone"
        android:textColor="#666666"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mail_container"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
