<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <WebView
        android:id="@+id/reader_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Draggable floating control bar. -->
    <LinearLayout
        android:id="@+id/reader_bar"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">

        <ImageView android:id="@+id/reader_grip" android:layout_width="22dp" android:layout_height="46dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <Button android:id="@+id/prev_button" style="?android:attr/borderlessButtonStyle"
            android:text="@string/reader_prev"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/open_button" style="?android:attr/borderlessButtonStyle"
            android:text="@string/reader_open"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/highlight_button" style="?android:attr/borderlessButtonStyle"
            android:text="@string/reader_highlight"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/settings_button" style="?android:attr/borderlessButtonStyle"
            android:text="@string/reader_aa"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/next_button" style="?android:attr/borderlessButtonStyle"
            android:text="@string/reader_next"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Top-left hamburger → directory of the actual books + surface jumps. -->
    <ImageButton
        android:id="@+id/goto_button"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bar_sections"
        android:background="#FFFFFF"
        android:contentDescription="@string/go_to_title"/>
</FrameLayout>
