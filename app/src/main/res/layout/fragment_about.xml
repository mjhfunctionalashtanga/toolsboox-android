<?xml version="1.0" encoding="utf-8"?>
<!-- Ledgable's own About: the version you're on, the door to the latest build, and the
     lineage owed to the upstream project ("The about is still about the original author…
     I'd say we convert that about page into a place where the latest version can be
     grabbed", 08-22). -->
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical">

        <ProgressBar
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:id="@+id/mainProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="-7dp"
                android:indeterminate="true"
                android:visibility="invisible"

                tools:visibility="visible"/>

        <TextView
                android:id="@+id/aboutAppTitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="26sp"
                android:textStyle="bold"
                android:text="@string/about_app_title"/>

        <TextView
                android:id="@+id/aboutVersion"
                android:layout_marginTop="6dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="16sp"
                tools:text="Version 1.06.72-00"/>

        <Button
                android:id="@+id/aboutUpdateButton"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="@string/about_update_button"/>

        <TextView
                android:id="@+id/aboutUpdateHint"
                android:layout_marginTop="8dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="13sp"
                android:text="@string/about_update_hint"/>

        <TextView
                android:id="@+id/aboutLineageTitle"
                android:layout_marginTop="28dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="20sp"
                android:text="@string/about_lineage_title"/>

        <TextView
                android:id="@+id/aboutLineageMessage"
                android:layout_marginTop="10dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:singleLine="false"
                android:text="@string/about_lineage_message"/>

        <TextView
                android:id="@+id/aboutLineageLink"
                android:layout_marginTop="6dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:singleLine="false"
                android:text=""/>

    </LinearLayout>
</ScrollView>
