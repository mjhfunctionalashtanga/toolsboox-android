<?xml version="1.0" encoding="utf-8"?>
<!-- A horizontal row so the tucked action rail sits IN THE LAYOUT FLOW beside the feed — the
     list and article pane end where the rail begins (no floating pill over rows), the day
     page's toolbarDrawing argument carried over. The gutter is authored on the start edge;
     setupActionRail re-docks it when the shared side pref says RIGHT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/feeds_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<FrameLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="#FFFFFF">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Full-width timeline filter across the very top: the date navigator scopes the feed
         (a finite feed to clear day to day), above BOTH the directory drawer and the list. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingTop="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <!-- ▦ hub first, then the RSS drawer button, then the strip — the same top-left hub
             door the day page has, so feeds isn't a room without the house key. -->
        <ImageButton
            android:id="@+id/feeds_hub_button"
            android:src="@drawable/ic_bar_sections"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_feed"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/feeds_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <!-- fitXY, like Tasks & Events: the strip's touch map assumes the 1404-wide bitmap spans
             the whole view — the default fitCenter letterboxed it, so taps landed off-slot. -->
        <ImageView
            android:id="@+id/navigatorImageView"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <Button
            android:id="@+id/view_toggle_button"
            android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- The active window, named plainly ("Week 30 · Jul 20–26") whenever the strip is parked off
         today — the strip alone never said WHAT it was filtering to. Tap = back to the live feed. -->
    <TextView
        android:id="@+id/feeds_window_label"
        android:visibility="gone"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Row below the timeline: directory drawer | list -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

    <!-- Persistent left directory pane (two-pane feed): feeds + unread counts + read/unread
         filter. Populated in code by renderDirectory(). Replaces the floating dropdown. -->
    <ScrollView
        android:id="@+id/directory_scroll"
        android:layout_width="0dp"
        android:layout_weight="0.40"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/feeds_directory"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <View android:id="@+id/directory_divider"
        android:layout_width="1dp" android:layout_height="match_parent" android:background="#D8D5CE"/>

    <LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="0.60"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/settings_panel"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/url_edit"
            android:hint="@string/feeds_url_hint"
            android:textColor="#000000" android:textColorHint="#888888"
            android:inputType="textUri"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/token_edit"
            android:hint="@string/feeds_token_hint"
            android:textColor="#000000" android:textColorHint="#888888"
            android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_settings_button"
            android:text="@string/feeds_save"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/feeds_empty"
        android:textColor="#666666"
        android:textSize="16sp"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Later List selection bar: shown only while selecting rows for bulk delete. Sits ABOVE
         the list (not floating over it) so no row hides under it; flat black-on-white with a
         hairline underline — no elevation or tint to gray out on e-ink. -->
    <LinearLayout
        android:id="@+id/later_select_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/later_select_count"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/later_select_delete"
            android:text="@string/feeds_select_delete"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/later_select_cancel"
            android:text="@android:string/cancel"
            android:layout_marginStart="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <View android:id="@+id/later_select_divider"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feeds_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- In-pane article: opening an article loads it HERE (right pane) so the feed
         directory + list stay put. Back returns to the list. -->
    <LinearLayout
        android:id="@+id/article_pane"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/article_back" android:src="@drawable/ic_nav_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter" android:padding="8dp"
                android:contentDescription="@string/reader_prev"
                android:layout_width="40dp" android:layout_height="40dp"/>
            <TextView android:id="@+id/article_title" android:maxLines="1" android:ellipsize="end"
                android:textColor="#000000" android:textSize="15sp"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <ImageButton android:id="@+id/article_browser" android:src="@drawable/ic_globe"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter" android:padding="9dp"
                android:contentDescription="@string/feeds_open_external"
                android:visibility="gone"
                android:layout_width="40dp" android:layout_height="40dp"/>
        </LinearLayout>
        <!-- Find within the open piece. Hidden until the rail's 🔍 asks for it, and it sits UNDER
             the title rather than over the bottom of the page for two reasons: the piece's first
             line stays put (a bar that grows from the bottom shoves the text you were reading),
             and the soft keyboard comes up from the bottom — a find bar down there would spend
             most of its life behind the keys. Same top-of-the-panel rule the handwriting pad
             follows. The ‹ › here step MATCHES; the rail's ⏫⏬ still step pieces. -->
        <LinearLayout
            android:id="@+id/article_find_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingHorizontal="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText
                android:id="@+id/article_find_field"
                android:hint="@string/feeds_find_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:textSize="15sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/article_find_count"
                android:textSize="14sp" android:textColor="#000000"
                android:gravity="center" android:minWidth="72dp"
                android:paddingHorizontal="4dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/article_find_prev"
                style="?android:attr/borderlessButtonStyle"
                android:text="@string/feeds_find_prev"
                android:contentDescription="@string/feeds_find_prev_desc"
                android:textSize="18sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/article_find_next"
                style="?android:attr/borderlessButtonStyle"
                android:text="@string/feeds_find_next"
                android:contentDescription="@string/feeds_find_next_desc"
                android:textSize="18sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/article_find_close"
                style="?android:attr/borderlessButtonStyle"
                android:text="@string/feeds_find_close"
                android:contentDescription="@string/feeds_find_close_desc"
                android:textSize="16sp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <WebView android:id="@+id/article_web"
                android:layout_width="match_parent" android:layout_height="match_parent"/>
            <!-- Page-turn zones: bottom CORNERS only, like thumbing a paper page (same fix as
                 the book reader). The old full-width 200dp band swallowed every touch in the
                 lower band — links couldn't pop their save-to-Later/gram menu and text couldn't
                 be selected there. Corners are the smallest defensible patch; the center stays
                 live for the content. Left = page up, right = page down. -->
            <LinearLayout android:id="@+id/article_tap_zones"
                android:orientation="horizontal"
                android:layout_width="match_parent" android:layout_height="120dp"
                android:layout_gravity="bottom">
                <View android:id="@+id/article_tap_left"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                <Space android:layout_width="0dp" android:layout_weight="2" android:layout_height="1dp"/>
                <View android:id="@+id/article_tap_right"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- The paging trio in its own pill on the right edge — the one pill had taken on
         refresh, settings, paging AND the article actions ("a second floating modal on the
         feeds list that helps take some of the weight off"). Paging is the high-frequency
         gesture, so it gets the thumb edge; the main pill keeps the occasional controls. -->
    <!-- The strip lives IN the right margin: tucked to the edge (2dp), slim padding, and the
         list reserves exactly its width as a gutter (keepListClearOfPill) — rows take all the
         remaining width instead of running underneath it. -->
    <LinearLayout
        android:id="@+id/feeds_nav_pill"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="118dp"
        android:gravity="center_horizontal"
        android:background="@drawable/ledger_bar_bg"
        android:padding="2dp">
        <ImageButton android:id="@+id/feeds_page_up" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
        <ImageButton android:id="@+id/feeds_goto" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/feeds_page_down" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
    </LinearLayout>

    <!-- Persistent floating nav pill (grip = tap to collapse), matching the day/article/
         almanac pills: ‹ page-up · ☰ directory (center) · › page-down over the list. -->
    <LinearLayout
        android:id="@+id/feeds_pill"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">

        <ImageView android:id="@+id/feeds_grip" android:layout_width="@dimen/ledger_grip_short" android:layout_height="@dimen/ledger_pill_button"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <!-- Refresh + settings(wrench) sit left of the ↑ carrot. -->
        <ImageButton android:id="@+id/refresh_button" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_refresh"/>
        <ImageButton android:id="@+id/settings_button" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/ic_wrench"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_settings"/>
        <!-- Article actions (shown only while reading an article in-pane). -->
        <ImageButton android:id="@+id/feeds_star" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_star"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_view_starred"/>
        <ImageButton android:id="@+id/feeds_note" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/ic_pencil"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/feeds_parsed" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_reader_view"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/feeds_tts" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_speaker"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/feeds_later" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_go_later"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_add_later"/>
        <!-- Shrunk article drawer (shown only when the pill is shrunk while reading):
             ⏫ last article · ⏬ next article. The ‹ › pair left this pill 07-24 — paging
             lives in the side nav pill and the corner tap zones; twice was clutter. -->
        <ImageButton android:id="@+id/feeds_dw_prev" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up2"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_prev_article"/>
        <ImageButton android:id="@+id/feeds_dw_next" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down2"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_next_article"/>
    </LinearLayout>

</FrameLayout>

</LinearLayout>
