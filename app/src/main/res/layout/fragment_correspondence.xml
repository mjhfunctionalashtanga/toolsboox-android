<?xml version="1.0" encoding="utf-8"?>
<!-- A horizontal row so the tucked action rail sits IN THE LAYOUT FLOW beside the page — the
     thread column ends where the rail begins. The gutter is authored on the start edge;
     setupActionRail re-docks it when the shared side pref says RIGHT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/correspondence_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<LinearLayout
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent">

    <!-- Nav line: the ▦ hub, then the real Almanac strip (the same 1404×140 navigator the day page
         draws). Correspondence was the one list surface with neither — its only way out was the ✕,
         which pops the back stack and therefore lands on the almanac day page nearly every time,
         because that is where you opened the directory from. One list surface without the house key
         every other one carries is a room you can only leave backwards.

         The strip here FILTERS the page rather than jumping into the calendar (CalendarNavBarHost
         does that whenever the host passes onSelectPeriod, exactly as Mail and the Feed do).
         Michael: "the correspondence top nav goes to the almanac instead of a correspondence
         filter"; asked which of two candidate screens he meant, he confirmed this one. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/correspondence_hub_button"
            android:src="@drawable/ic_bar_sections"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp"
            android:layout_height="32dp"/>

        <ImageView
            android:id="@+id/correspondence_navigator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/correspondence_title"
            android:text="Correspondence"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <!-- Reading size: re-lays the page out larger rather than magnifying it, so the text
             stays sharp on the panel. Pictures zoom by tapping them. -->
        <TextView
            android:id="@+id/correspondence_text_size"
            android:text="A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/correspondence_refresh"
            android:text="⟳"
            android:textSize="22sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/correspondence_close"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/correspondence_container"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>

</LinearLayout>
