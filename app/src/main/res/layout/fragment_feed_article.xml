<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <WebView
        android:id="@+id/article_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Page-turn zones: bottom CORNERS only, like thumbing a paper page (same fix as the book
         reader). The old full-width 230dp band swallowed every touch in the lower quarter —
         links couldn't pop their save-to-Later/gram menu, text couldn't be selected there.
         Corners are the smallest defensible patch; the center stays live for the content.
         L/R = page back/forward; double = prev/next article; triple L = feed list, triple R =
         next feed. Toggled in the ☰ menu. -->
    <LinearLayout
        android:id="@+id/tap_zones"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:visibility="gone">
        <View android:id="@+id/tap_left" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"/>
        <Space android:layout_width="0dp" android:layout_weight="2" android:layout_height="1dp"/>
        <View android:id="@+id/tap_right" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- Floating, draggable nav pill (grip = tap to collapse). Mirrors the day-page pill:
         ☰ RSS directory (long-press = browser/settings) · ☆ star · ⛶ parse ·
         ‹ page-up · ⌃ prev-article · ✎ annotate (center) · ⌄ next-article · › page-down. -->
    <LinearLayout
        android:id="@+id/art_pill"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">

        <ImageView android:id="@+id/art_grip" android:layout_width="@dimen/ledger_grip_short" android:layout_height="@dimen/ledger_pill_button"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <ImageButton android:id="@+id/art_today" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_today"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/art_menu" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/art_star" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_star"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_star"/>
        <ImageButton android:id="@+id/art_parse" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_reader_view"
            android:background="@android:color/transparent" android:contentDescription="@string/feeds_article_parse"/>
        <ImageButton android:id="@+id/art_page_up" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_left"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
        <ImageButton android:id="@+id/art_prev" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up2"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_article_first"/>
        <ImageButton android:id="@+id/art_annotate" android:layout_width="44dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_pencil"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_highlight"/>
        <ImageButton android:id="@+id/art_next" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down2"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/feeds_article_last"/>
        <ImageButton android:id="@+id/art_page_down" android:layout_width="42dp" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_right"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
    </LinearLayout>
</FrameLayout>
