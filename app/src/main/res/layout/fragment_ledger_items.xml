<?xml version="1.0" encoding="utf-8"?>
<!-- A horizontal row so the tucked action rail sits IN THE LAYOUT FLOW beside the list — the
     rows end where the rail begins (no floating pill over them). The gutter is authored on
     the start edge; setupActionRail re-docks it when the shared side pref says RIGHT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/items_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<FrameLayout
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Menu anchor sits on the nav line, left of the back carrot; no title. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_calendar_today"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="34dp" android:layout_height="34dp"/>
        <!-- The REAL Almanac day navigator (same strip the day page draws). -->
        <ImageView
            android:id="@+id/navigatorImageView"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="50dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/calendar_navigator_image"/>
        <!-- Columns mode swaps the day navigator for the board name: the board view reads the
             whole ledger, so a date strip would promise a scoping it doesn't do. The dropdown
             names where you are, like a directory chip. Hidden in list mode. -->
        <Button
            android:id="@+id/items_board"
            android:text="All boards  ▾"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Finger / no-pen capture: type a task or event. -->
    <LinearLayout
        android:id="@+id/add_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/add_task_button"
            android:text="＋ Task"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/add_event_button"
            android:text="＋ Event"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/select_button"
            android:text="☑ Select"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Bulk-select action bar (shown after a long-press enters selection mode). -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/selection_count"
            android:textColor="#000000" android:textSize="16sp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/select_all_button"
            android:text="All"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/delete_selected_button"
            android:text="🗑 Delete"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/cancel_selection_button"
            android:text="Cancel"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/ledger_items_empty"
        android:textColor="#666666" android:textSize="16sp" android:padding="22dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <!-- Today's birthdays from the rolodex (tappable → the contact). Filled in code. -->
    <LinearLayout
        android:id="@+id/birthdays_container"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- The OTHER rendering of the same drawer: the swimlane board. One of this and the recycler
         is visible at a time — "a note is a place, a board is a lens", and the ▤/☰ rail button
         flips the lens in place. Waiting sits between Doing and Done: the lane for work that is
         out of your hands but not out of your ledger. -->
    <LinearLayout
        android:id="@+id/items_columns"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="#F2F2F2" android:padding="6dp">
            <TextView android:id="@+id/col_todo_head" android:text="TO DO" android:textColor="#666666" android:textStyle="bold" android:textSize="12sp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/col_todo_cards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="#F2F2F2" android:padding="6dp">
            <TextView android:id="@+id/col_doing_head" android:text="DOING" android:textColor="#666666" android:textStyle="bold" android:textSize="12sp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/col_doing_cards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="#F2F2F2" android:padding="6dp">
            <TextView android:id="@+id/col_waiting_head" android:text="WAITING" android:textColor="#666666" android:textStyle="bold" android:textSize="12sp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/col_waiting_cards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="4dp" android:background="#F2F2F2" android:padding="6dp">
            <TextView android:id="@+id/col_done_head" android:text="DONE" android:textColor="#666666" android:textStyle="bold" android:textSize="12sp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/col_done_cards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- The learner card: one thing from your own ledger, come back around. -->
    <LinearLayout
        android:id="@+id/learner_card"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

    <!-- Floating nav pill (unified): ‹ page-up · ☀ today/menu · page-down ›. -->
    <LinearLayout
        android:id="@+id/items_pill"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">
        <ImageView android:id="@+id/items_grip" android:layout_width="@dimen/ledger_grip_short" android:layout_height="@dimen/ledger_pill_button"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <ImageButton android:id="@+id/items_page_up" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
        <ImageButton android:id="@+id/items_goto" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_today"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/items_page_down" android:layout_width="@dimen/ledger_pill_button" android:layout_height="@dimen/ledger_pill_button"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
    </LinearLayout>

</FrameLayout>

</LinearLayout>
