<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Menu anchor sits on the nav line, left of the back carrot; no title. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_calendar_today"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="34dp" android:layout_height="34dp"/>
        <!-- The REAL Almanac day navigator (same strip the day page draws). -->
        <ImageView
            android:id="@+id/navigatorImageView"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="50dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/calendar_navigator_image"/>
    </LinearLayout>

    <!-- Finger / no-pen capture: type a task or event. -->
    <LinearLayout
        android:id="@+id/add_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/add_task_button"
            android:text="＋ Task"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/add_event_button"
            android:text="＋ Event"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/select_button"
            android:text="☑ Select"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg"
            android:minHeight="48dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Bulk-select action bar (shown after a long-press enters selection mode). -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/selection_count"
            android:textColor="#000000" android:textSize="16sp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/select_all_button"
            android:text="All"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/delete_selected_button"
            android:text="🗑 Delete"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/cancel_selection_button"
            android:text="Cancel"
            android:textAllCaps="false" android:textColor="#000000" android:textSize="16sp"
            android:background="@drawable/dialog_rounded_bg" android:minHeight="48dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/ledger_items_empty"
        android:textColor="#666666" android:textSize="16sp" android:padding="22dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <!-- Today's birthdays from the rolodex (tappable → the contact). Filled in code. -->
    <LinearLayout
        android:id="@+id/birthdays_container"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Write a task by hand: a strip you can write straight onto, with ＋ to add it. Keeping it
         at the foot of the list means a task can be written where the tasks already are, in the
         same hand as the rest of the page.

         The caption below is the only thing that says so. Until it existed, the strip was a bare
         black rectangle with two glyphs beside it: nothing on screen told you it was for writing,
         and an undescribed box on an e-ink page reads as a rendering fault rather than an
         invitation. -->
    <TextView
        android:id="@+id/ink_task_label"
        android:text="@string/ledger_ink_task_label"
        android:textSize="12sp"
        android:textColor="#666666"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/ink_task_box"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp"
        android:paddingTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/ink_task_frame"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="74dp"
            android:background="#000000"
            android:padding="2dp"/>

        <TextView
            android:id="@+id/ink_task_undo"
            android:text="↶"
            android:textSize="20sp"
            android:contentDescription="@string/ledger_ink_task_undo"
            android:textColor="#555555"
            android:paddingHorizontal="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/ink_task_add"
            android:text="＋"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- The learner card: one thing from your own ledger, come back around. -->
    <LinearLayout
        android:id="@+id/learner_card"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

    <!-- Floating nav pill (unified): ‹ page-up · ☀ today/menu · page-down ›. -->
    <LinearLayout
        android:id="@+id/items_pill"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">
        <ImageView android:id="@+id/items_grip" android:layout_width="22dp" android:layout_height="44dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <ImageButton android:id="@+id/items_page_up" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
        <ImageButton android:id="@+id/items_goto" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_today"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/items_page_down" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
    </LinearLayout>

</FrameLayout>
