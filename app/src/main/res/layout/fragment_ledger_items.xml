<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/ledger_items_title"
            android:textSize="24sp" android:textStyle="bold" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_calendar_today"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="34dp" android:layout_height="34dp"/>
    </LinearLayout>

    <!-- Day pager: ‹ date › -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton android:id="@+id/prev_button" android:src="@drawable/ic_nav_left"
            android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter"
            android:padding="8dp" android:contentDescription="@string/reader_prev"
            android:layout_width="40dp" android:layout_height="40dp"/>
        <TextView android:id="@+id/day_title" android:gravity="center" android:textSize="17sp"
            android:textColor="#000000" android:maxLines="1"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <ImageButton android:id="@+id/next_button" android:src="@drawable/ic_nav_right"
            android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter"
            android:padding="8dp" android:contentDescription="@string/reader_next"
            android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/ledger_items_empty"
        android:textColor="#666666" android:textSize="16sp" android:padding="22dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
