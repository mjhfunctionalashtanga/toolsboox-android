<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:id="@+id/main_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-7dp"
            android:indeterminate="true"
            android:visibility="invisible"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:visibility="visible"/>

    <TextView
            android:id="@+id/title_text"
            android:text="@string/michaelfilter_intake_title"
            android:textSize="36sp"
            android:textColor="#000000"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/main_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="#000000"

            app:layout_constraintTop_toBottomOf="@id/title_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"

            app:layout_constraintTop_toBottomOf="@id/title_text"
            app:layout_constraintBottom_toTopOf="@id/status_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/michaelfilter_intake_url_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                <EditText
                        android:id="@+id/url_edit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_intake_field"
                        android:hint="@string/michaelfilter_intake_url_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textColorHint="#666666"
                        android:textSize="18sp"/>

                <Button
                        android:id="@+id/paste_button"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:text="@string/michaelfilter_intake_paste"
                        android:textSize="18sp"/>
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/michaelfilter_intake_kind_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

            <RadioGroup
                    android:id="@+id/kind_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                <RadioButton
                        android:id="@+id/kind_read"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:paddingEnd="24dp"
                        android:text="@string/michaelfilter_intake_kind_read"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        tools:ignore="RtlSymmetry"/>

                <RadioButton
                        android:id="@+id/kind_listen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="24dp"
                        android:text="@string/michaelfilter_intake_kind_listen"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        tools:ignore="RtlSymmetry"/>

                <RadioButton
                        android:id="@+id/kind_watch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/michaelfilter_intake_kind_watch"
                        android:textColor="#000000"
                        android:textSize="20sp"/>
            </RadioGroup>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/michaelfilter_intake_title_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

            <EditText
                    android:id="@+id/title_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_intake_field"
                    android:hint="@string/michaelfilter_intake_title_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#666666"
                    android:textSize="18sp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/michaelfilter_intake_text_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

            <EditText
                    android:id="@+id/text_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_intake_field"
                    android:gravity="top|start"
                    android:hint="@string/michaelfilter_intake_text_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="6"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="#000000"
                    android:textColorHint="#666666"
                    android:textSize="18sp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/michaelfilter_intake_why_label"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

            <EditText
                    android:id="@+id/why_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_intake_field"
                    android:gravity="top|start"
                    android:hint="@string/michaelfilter_intake_why_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#666666"
                    android:textSize="18sp"/>

            <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/michaelfilter_intake_save"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/pending_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="2 queued for retry"
                    tools:visibility="visible"/>
        </LinearLayout>
    </ScrollView>

    <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:text="In tomorrow's edition."/>
</androidx.constraintlayout.widget.ConstraintLayout>
