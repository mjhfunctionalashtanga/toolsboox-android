<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"

        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:id="@+id/main_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-7dp"
            android:indeterminate="true"
            android:visibility="invisible"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:visibility="visible"/>

    <TextView
            android:id="@+id/title_text"
            android:text="@string/calendar_settings_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/atkinson_hyperlegible"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"

            app:layout_constraintTop_toBottomOf="@id/main_progress"
            app:layout_constraintStart_toStartOf="parent"/>

    <View
            android:id="@+id/title_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="#D0D0D0"

            app:layout_constraintTop_toBottomOf="@id/title_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipToPadding="false"

            app:layout_constraintTop_toBottomOf="@id/title_divider"
            app:layout_constraintBottom_toTopOf="@id/button_bar_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!-- ORDER OF THIS PAGE, and why.
                 It used to be a flat run of nine sections in the order they were written, so the
                 setting people come here for most — Legibility — sat at the very bottom under a
                 heading that said BACKUP & DATA, three screens past anything to do with looking at
                 things. The order now runs by what you came to change: first how it LOOKS right
                 now (legibility, which way up), then how the planner BEHAVES, then what happens to
                 your INK, then the four places pages GO, and last the archive and upkeep errands
                 you touch once a year. Every heading names a visible effect, not the subsystem
                 underneath it. -->

            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/look_section_label"
                    android:text="@string/calendar_settings_look_label"/>

            <!-- One button to a dialog that holds seven dials. It was the last widget on the page;
                 it is now the first, because "make this readable" is the errand that brings someone
                 to Settings on an e-ink screen in bad light. -->
            <Button
                    android:id="@+id/button_text_size"
                    android:text="@string/calendar_settings_button_text_size"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

            <View
                    android:id="@+id/divider_look"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- Rotation. Hold-to-gyro on the rotate button proved undiscoverable and unreliable on
                 the Palma, so the same thing is a plain switch here. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/rotation_section_label"
                    android:text="@string/calendar_settings_rotation_label"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/auto_rotate_switch"
                    android:text="@string/calendar_settings_auto_rotate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <!-- The four tick-boxes configure ONE thing: the cycle the toolbar's rotate button
                 steps through (ScreenFragment.stepScreenOrientation reads rotationOrientationMask,
                 and it is the only reader). Hand the screen to the gyro and there is no cycle left
                 to configure — the boxes stayed on screen anyway, four live-looking controls that
                 changed nothing you could see. Grouped so the whole cluster hides behind the one
                 decision above it; the mask itself is untouched while hidden, so turning the gyro
                 back off restores exactly the cycle that was there. -->
            <LinearLayout
                    android:id="@+id/rotation_manual_group"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <TextView
                        android:id="@+id/rotation_section_hint"
                        android:text="@string/calendar_settings_rotation_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"/>

                <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/rotation_portrait_check"
                        android:text="@string/calendar_settings_rotation_portrait"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="16dp"/>

                <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/rotation_landscape_cw_check"
                        android:text="@string/calendar_settings_rotation_landscape_cw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"/>

                <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/rotation_reverse_portrait_check"
                        android:text="@string/calendar_settings_rotation_reverse_portrait"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"/>

                <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/rotation_landscape_ccw_check"
                        android:text="@string/calendar_settings_rotation_landscape_ccw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"/>
            </LinearLayout>

            <View
                    android:id="@+id/divider_rotation"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- The auto-capture switch used to float above the first section heading, with no
                 group at all. It now lives under "HANDWRITING" further down. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/calendar_section_label"
                    android:text="@string/calendar_settings_calendar_label"/>

            <TextView
                    android:id="@+id/start_view_spinner_text"
                    android:text="@string/calendar_settings_select_start_view_text"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:id="@+id/start_view_spinner_layout"
                    android:spinnerMode="dropdown"

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp">

                <com.toolsboox.ot.AutoCompleteTextView
                        android:id="@+id/start_view_spinner"
                        android:labelFor="@id/start_view_spinner_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#e0e0e0"/>

            <TextView
                    android:id="@+id/start_hour_spinner_text"
                    android:text="@string/calendar_settings_select_start_hour_text"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:id="@+id/start_hour_spinner_layout"
                    android:spinnerMode="dropdown"

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp">

                <com.toolsboox.ot.AutoCompleteTextView
                        android:id="@+id/start_hour_spinner"
                        android:labelFor="@id/start_hour_spinner_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#e0e0e0"/>

            <TextView
                    android:id="@+id/note_template_spinner_text"
                    android:text="@string/calendar_settings_select_note_template_text"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:id="@+id/note_template_spinner_layout"
                    android:spinnerMode="dropdown"

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp">

                <com.toolsboox.ot.AutoCompleteTextView
                        android:id="@+id/note_template_spinner"
                        android:labelFor="@id/note_template_spinner_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:id="@+id/divider_note_template"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#e0e0e0"/>

            <!-- Locale, moved to the END of this section from the middle of it. The three spinners
                 above are things you change to taste; this one you set once, on the day the device
                 comes out of the box, and it is only here to answer "why does my week start on a
                 Sunday". Putting a set-once control between two taste controls made the section
                 read as four unrelated dropdowns. -->
            <TextView
                    android:id="@+id/locales_spinner_text"
                    android:text="@string/calendar_settings_select_locale_text"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:id="@+id/locales_spinner_layout"
                    android:spinnerMode="dropdown"

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp">

                <com.toolsboox.ot.AutoCompleteTextView
                        android:id="@+id/locales_spinner"
                        android:labelFor="@id/locales_spinner_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:completionThreshold="1"
                        android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- What the locale above IMPLIES, on one line. This was six stacked full-width
                 TextViews — three captions and three values — for something nobody can edit: it is
                 a read-out of the dropdown, not a setting, and stacked like that it looked like
                 three more settings that refused to respond to being tapped. Same three value
                 views, same ids (updateLocaleSettings still writes them by name), one row. -->
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp">

                <TextView
                        android:text="@string/calendar_settings_locale_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"/>

                <TextView
                        android:id="@+id/calendar_first_day_of_the_week_value"
                        android:text="@string/calendar_settings_first_day_of_the_week_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                <TextView
                        android:text="·"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>

                <TextView
                        android:id="@+id/calendar_week_number_of_first_day_value"
                        android:text="@string/calendar_settings_week_number_of_first_day_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                <TextView
                        android:text="–"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>

                <TextView
                        android:id="@+id/calendar_week_number_of_last_day_value"
                        android:text="@string/calendar_settings_week_number_of_last_day_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                    android:id="@+id/divider_locale"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- HANDWRITING. Moved up from below the four connection blocks: what happens to your
                 ink is a property of the page you write on, not of a server, and it was stranded
                 among credential boxes. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/capture_section_label"
                    android:text="@string/calendar_settings_capture_label"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/auto_capture_switch"
                    android:text="@string/calendar_settings_capture_enable"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/auto_extract_switch"
                    android:text="@string/calendar_settings_extract_enable"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"/>

            <!-- Was a bare title TextView reading "On-device extract" above the switch — two lines
                 saying the same word twice. It carries the caveat instead, because the switch's
                 real effect (a menu item appears) is not what "extract" leads anyone to expect. -->
            <TextView
                    android:id="@+id/auto_extract_hint"
                    android:text="@string/calendar_settings_extract_title"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"/>

            <View
                    android:id="@+id/divider_capture"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- THE FOUR DESTINATIONS, back to back: toolsBoox cloud, WebDAV, Google Calendar,
                 WordPress. They answer one question — where does this end up — and each already
                 hides its own fields behind an enable switch, so the run reads as four one-line
                 choices until you turn one on. Google Calendar and the sites block used to be
                 split apart by the capture settings sitting in the middle of them. -->

            <!-- Auto-sync section -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/auto_sync_section_label"
                    android:text="@string/calendar_settings_auto_sync_label"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/auto_sync_switch"
                    android:text="@string/calendar_settings_auto_sync_enabled"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <TextView
                    android:id="@+id/auto_sync_interval_text"
                    android:text="@string/calendar_settings_auto_sync_interval_text"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:id="@+id/auto_sync_interval_spinner_layout"
                    android:spinnerMode="dropdown"

                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="16dp">

                <com.toolsboox.ot.AutoCompleteTextView
                        android:id="@+id/auto_sync_interval_spinner"
                        android:labelFor="@id/auto_sync_interval_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:id="@+id/divider_auto_sync"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#e0e0e0"/>

            <!-- Ultrabridge Backup section -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/ultrabridge_section_label"
                    android:text="@string/calendar_settings_ultrabridge_title"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/ultrabridge_enable_switch"
                    android:text="@string/calendar_settings_ultrabridge_enable"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                    android:id="@+id/ultrabridge_url_layout"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"

                    android:hint="@string/calendar_settings_ultrabridge_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ultrabridge_url_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                    android:id="@+id/ultrabridge_user_layout"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"

                    android:hint="@string/calendar_settings_ultrabridge_user_hint">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ultrabridge_user_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                    android:id="@+id/ultrabridge_pass_layout"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"

                    android:hint="@string/calendar_settings_ultrabridge_pass_hint"
                    app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ultrabridge_pass_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:id="@+id/divider_ultrabridge"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- Google Calendar (events) section -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/gcal_section_label"
                    android:text="@string/calendar_settings_gcal_title"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/gcal_enable_switch"
                    android:text="@string/calendar_settings_gcal_enable"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                    android:id="@+id/gcal_id_layout"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"

                    android:hint="@string/calendar_settings_gcal_id_hint">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/gcal_id_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                    android:id="@+id/gcal_connect_button"
                    android:text="@string/calendar_settings_gcal_connect"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"/>

            <View
                    android:id="@+id/divider_gcal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- Sites & bridge. "Manage sites" is the SOURCE OF TRUTH (every WordPress site + the
                 active one). The single-cred fields below are the same active-site bridge as an
                 advanced quick-edit — they write the same prefs, so editing them mirrors, and can
                 override, the active site. Hidden behind the toggle so the two aren't mistaken for
                 rival editors. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/community_section_label"
                    android:text="@string/calendar_settings_community_label"/>

            <Button
                    android:id="@+id/button_manage_sites"
                    android:text="@string/calendar_settings_button_manage_sites"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

            <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/community_enable_switch"
                    android:text="@string/calendar_settings_community_enable"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/community_site_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Community site URL (https://…)">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/community_site_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/community_user_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="WordPress username">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/community_user_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/community_pass_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Application password">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/community_pass_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/community_board_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="FluentBoards board ID (for pinned grams)">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/community_board_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                    android:id="@+id/divider_sites"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- BACKUP & TRANSFER. Six buttons used to sit here in the order somebody added them,
                 so the pair you actually want together ("Export settings", "Import settings") was
                 split by a calendar-only zip and a full-ledger restore, and the whole run was
                 shuffled in with a shortcut maker and a mark rebuilder. Now: settings out, settings
                 in, the gesture that turns those two into a whole-ledger backup, then the restore
                 that reads such a backup, then the odd one out (calendar-only) last and labelled
                 as the different thing it is. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/data_section_label"
                    android:text="@string/calendar_settings_data_label"/>

            <Button
                    android:id="@+id/button_export_settings"
                    android:text="@string/calendar_settings_button_export_settings"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>

            <Button
                    android:id="@+id/button_import_settings"
                    android:text="@string/calendar_settings_button_import_settings"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

            <TextView
                    android:id="@+id/backup_gesture_hint"
                    android:text="@string/calendar_settings_backup_gesture_hint"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"/>

            <Button
                    android:id="@+id/button_restore"
                    android:text="@string/calendar_settings_button_restore"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>

            <Button
                    android:id="@+id/button_backup"
                    android:text="@string/calendar_settings_button_backup"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>

            <View
                    android:id="@+id/divider_data"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:background="#e0e0e0"/>

            <!-- The two errands that are neither a preference nor an archive: one puts an icon on
                 the launcher, the other reindexes local files. They were filed under "BACKUP &
                 DATA" because there was nowhere else, which is how "Update marks" came to sit
                 between two backup buttons and read as a sync. -->
            <TextView
                    style="@style/Settings.SectionHeading"
                    android:id="@+id/device_section_label"
                    android:text="@string/calendar_settings_device_label"/>

            <Button
                    android:id="@+id/button_shortcut"
                    android:text="@string/calendar_settings_button_shortcut"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>

            <Button
                    android:id="@+id/button_pattern_sync"
                    android:text="@string/calendar_settings_button_pattern_sync"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <View
            android:id="@+id/button_bar_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="#e0e0e0"

            app:layout_constraintTop_toTopOf="@id/button_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <Button
            android:id="@+id/button_save"
            android:text="@string/calendar_settings_button_save"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_back"
            app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
            android:id="@+id/button_back"
            android:text="@string/calendar_settings_button_back"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toEndOf="@id/button_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
