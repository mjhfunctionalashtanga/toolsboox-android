<?xml version="1.0" encoding="utf-8"?>
<!-- A read-and-wander page shared by the three semantic action-surfaces — Quick Wins, Sprouts and
     Missed Connections. The Almanac strip on top, a title line
     with a Close, then a column of cards that scrolls on e-ink. Each fragment fills the column
     differently; the frame is one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- The tucked action rail's gutter — in the layout flow, so the cards end where the rail
         begins; setupActionRail re-docks it when the shared side pref says RIGHT. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/semantic_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- The real Almanac strip (same 1404×140 navigator the day page draws), FIRST — every other
         dated surface (Feed, Boards &amp; Tasks) leads with the strip, and these pages stacking
         a big bold title over it read as a second, stale headline. Wired by
         [com.toolsboox.plugin.calendar.ui.SemanticNavBar]: on Missed Connections it
         FILTERS the surface in place; on Quick Wins it stays a place to leave from.
         The ▦ hub sits top-left of it — the same house key feeds and the day page carry, so these
         aren't rooms you can only leave through Back. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingTop="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/semantic_hub_button"
            android:src="@drawable/ic_bar_sections"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <ImageView
            android:id="@+id/semantic_navigator"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/semantic_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/semantic_action"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/semantic_close"
            android:text="@string/ledger_close"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/semantic_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/semantic_column"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>

</LinearLayout>
