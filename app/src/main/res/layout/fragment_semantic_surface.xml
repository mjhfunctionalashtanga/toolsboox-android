<?xml version="1.0" encoding="utf-8"?>
<!-- A read-and-wander page shared by the three semantic action-surfaces — Quick Wins, Sprouts and
     Missed Rhizomes. Same shape as fragment_ledger_roots: a title line with a Close, then a column
     of cards that scrolls on e-ink. Each fragment fills the column differently; the frame is one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/semantic_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/semantic_action"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/semantic_close"
            android:text="@string/roots_close"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- The real Almanac strip (same 1404×140 navigator the day page draws). These surfaces aren't one
         day, so the date is a place to LEAVE from: step to a day and open it, or tap a period to jump
         into the calendar. Wired by [com.toolsboox.plugin.calendar.ui.SemanticNavBar], as on Roots. -->
    <ImageView
        android:id="@+id/semantic_navigator"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:contentDescription="@null"/>

    <ScrollView
        android:id="@+id/semantic_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/semantic_column"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
