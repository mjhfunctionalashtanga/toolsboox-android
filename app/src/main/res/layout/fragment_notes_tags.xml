<?xml version="1.0" encoding="utf-8"?>
<!-- Notes & Tags — a period-filtered list (week / month / quarter / year window around a date)
     of the days that hold note content and/or #tags, driven by the Almanac navigator as its
     filter. Modeled on the Feed / Reading-log list surfaces (same nav strip + floating pill). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Nav line: hamburger left of the navigator (unified with feed / Tasks & Events / log). -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/goto_button"
            android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <ImageView
            android:scaleType="fitXY"
            android:id="@+id/navigatorImageView"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp"
            android:contentDescription="@null"/>
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/title_text"
        android:text="@string/notes_tags_title"
        android:textSize="24sp" android:textStyle="bold" android:textColor="#000000"
        android:paddingHorizontal="14dp" android:paddingTop="6dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <!-- The current period + level, in words (e.g. "Week · Jul 21 – Jul 27, 2026"). -->
    <TextView
        android:id="@+id/period_text"
        android:textSize="15sp" android:textColor="#444444"
        android:paddingHorizontal="14dp" android:paddingBottom="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/empty_text"
        android:text="@string/notes_tags_empty"
        android:textColor="#666666"
        android:textSize="16sp"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ScrollView
        android:id="@+id/notes_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/notes_column"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="88dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>

    <!-- Floating nav pill (unified with feed/almanac): level cycle · ‹ page-up · ☀ today/menu · page-down ›. -->
    <LinearLayout
        android:id="@+id/notes_pill"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/ledger_bar_bg"
        android:padding="4dp">
        <ImageView android:id="@+id/notes_grip" android:layout_width="22dp" android:layout_height="44dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_grip" android:contentDescription="@null"/>
        <!-- Cycles the almanac ladder level: Week → Month → Quarter → Year (widen), wrapping. -->
        <Button android:id="@+id/level_button"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="14sp" android:minWidth="0dp" android:paddingHorizontal="8dp"
            android:layout_width="wrap_content" android:layout_height="44dp"/>
        <ImageButton android:id="@+id/notes_page_up" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_up"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_prev"/>
        <ImageButton android:id="@+id/notes_goto" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_today"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/go_to_title"/>
        <ImageButton android:id="@+id/notes_page_down" android:layout_width="46dp" android:layout_height="44dp"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_nav_down"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/reader_next"/>
    </LinearLayout>

</FrameLayout>
