<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView
        android:id="@+id/title_text"
        android:text="@string/ledger_chat_title"
        android:textSize="34sp"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:text="@string/ledger_chat_subtitle"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>

    <!-- Scope: everything, or pick sections -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox android:id="@+id/scope_books" android:text="@string/ledger_chat_scope_books"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_articles" android:text="@string/ledger_chat_scope_articles"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <CheckBox android:id="@+id/scope_planner" android:text="@string/ledger_chat_scope_planner"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_media" android:text="@string/ledger_chat_scope_media"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <EditText
        android:id="@+id/question_edit"
        android:hint="@string/ledger_chat_hint"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:gravity="top"
        android:background="#F2F2F2"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/ask_button"
        android:text="@string/ledger_chat_ask"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/answer_text"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <!-- Collapsible key/model row -->
    <TextView
        android:id="@+id/settings_toggle"
        android:text="@string/ledger_chat_settings_toggle"
        android:textColor="#3366CC"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/settings_panel"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/api_key_edit"
            android:hint="@string/ledger_chat_api_key_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/model_edit"
            android:hint="@string/ledger_chat_model_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_key_button"
            android:text="@string/ledger_chat_save_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
