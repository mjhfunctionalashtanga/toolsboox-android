<?xml version="1.0" encoding="utf-8"?>
<!--
  Notebot — the Ask-my-Ledger conversation surface (DESIGN-NOTEBOT-VOICE.md §7).

  Transcript, not bubbles: chat bubbles on e-ink are grey rounded smudges that waste half the
  line width on asymmetric margins. This is a ledger-page transcript — question in bold, full
  width; answer in regular weight beneath it; a small receipt caption under answers that used
  tools; a hairline rule between turns; newest at the bottom, scrolled to. Flat white.

  The input row sits at the bottom. The recording bar, the countdown pill and the speaking pill
  swap in place with the input row's space when active — states swap in place; nothing floats.

  IF INK EVER BECOMES AN INPUT here (a scribbled question on a pad), the promptTitle rule
  applies unmodified: action buttons build INTO the panel content, index 0, ABOVE the ink —
  never platform buttons at the bottom under a hand. v1 is voice and type; the rule is recorded
  here so the v2 that adds the pad inherits it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Title row: title, the remembered speaker toggle (voice-out override), the ▦ directory. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">
        <TextView
            android:id="@+id/title_text"
            android:text="@string/ledger_chat_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <!-- Voice-out default is symmetry (spoken question → spoken answer, typed → silent);
             this toggle overrides in both directions and is remembered. Cycles Auto/On/Off. -->
        <TextView
            android:id="@+id/speaker_toggle"
            android:text="🔊 Auto"
            android:textSize="15sp"
            android:textColor="#000000"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Speak answers"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_calendar_today"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="34dp" android:layout_height="34dp"/>
    </LinearLayout>

    <TextView
        android:text="@string/ledger_chat_subtitle"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"/>

    <!--
      What was sent, sitting above the transcript for the whole visit.

      The passage has always ridden the grounding (`ask_context`); what it never did was show its
      face, so the one thing you could not check while choosing a prompt was WHICH highlight you
      were about to ask about. Four lines and a cross: enough to recognise it, not so much that it
      becomes the page. The cross drops the grounding with it — one gesture, one meaning, no state
      where the model is still reading a passage you thought you had put down.
    -->
    <LinearLayout
        android:id="@+id/passage_banner"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@drawable/eink_edit_bg"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/passage_text"
            android:textColor="#000000"
            android:textSize="14sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/passage_clear"
            android:text="✕"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ledger_chat_passage_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Scope: everything, or pick sections. Feeds search_ledger's corpus gather. -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox android:id="@+id/scope_books" android:text="@string/ledger_chat_scope_books"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_articles" android:text="@string/ledger_chat_scope_articles"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_feed" android:text="Feed articles"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <CheckBox android:id="@+id/scope_planner" android:text="@string/ledger_chat_scope_planner"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_media" android:text="@string/ledger_chat_scope_media"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!--
      The prompt presets, as a row of chips directly over the transcript. A preset is spent at
      the moment of asking: it has to be one tap from the question. Presets now fire as TURNS in
      the transcript instead of replacing a lone answer. Filled programmatically by
      [LedgerChatFragment.rebuildPresetRow]: tap asks, hold edits/deletes — hold-to-act, no modes.
    -->
    <HorizontalScrollView
        android:id="@+id/preset_scroll"
        android:scrollbars="none"
        android:layout_marginBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/preset_row"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <!-- The transcript: turns are appended programmatically (bold question, plain answer,
         receipt caption, hairline rule). Appending a turn invalidates from the new turn down,
         not the page — full-refresh discipline. -->
    <ScrollView
        android:id="@+id/transcript_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:id="@+id/transcript"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Speaking state, flat: one pill over the answer area; tap stops the voice. No
         pause/resume transport — an answer short enough to converse with doesn't need one. -->
    <TextView
        android:id="@+id/speaking_pill"
        android:text="🔊 Speaking — tap to stop"
        android:textSize="15sp"
        android:textColor="#000000"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/eink_edit_bg"
        android:padding="10dp"
        android:layout_marginBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- VOICE STATES, all flat (e-ink canon: no waveform, no pulse — a moving level meter on
         e-ink is a strobing grey rectangle). These swap in place with the input row below:
         recording bar while the mic is open; countdown pill during the hold-path's visible
         2.5 s "Sending — tap to edit" window. Labels update by the second, not by frame. -->
    <TextView
        android:id="@+id/recording_bar"
        android:text="● Listening 0:00 — tap Stop"
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/eink_edit_bg"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/countdown_pill"
        android:text="● Sending in 3 — tap to edit"
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/eink_edit_bg"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- The input row, bottom of screen: question field, mic (tap = dictate-then-edit,
         hold = talk-and-send), send. Nothing is ever sent that was not first shown. -->
    <LinearLayout
        android:id="@+id/input_row"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/question_edit"
            android:hint="@string/ledger_chat_hint"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:textSize="17sp"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="1"
            android:maxLines="4"
            android:gravity="top"
            android:background="@drawable/eink_edit_bg"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/mic_button"
            android:text="🎤"
            android:textSize="18sp"
            android:contentDescription="@string/ledger_chat_dictate"
            android:layout_marginStart="6dp"
            android:minWidth="56dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/ask_button"
            android:text="@string/ledger_chat_ask"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/eink_button_solid"
            android:stateListAnimator="@null"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!--
          Two keeps, not one. The feed is for something to come back past you again; a text note is
          a thing you have KEPT, titled by the question, with the provenance attached.
        -->
        <Button
            android:id="@+id/save_note_button"
            android:text="@string/ledger_chat_save_note"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_feed_button"
            android:text="@string/ledger_chat_save_feed"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/history_button"
            android:text="@string/ledger_chat_history"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Collapsible key/model row -->
    <TextView
        android:id="@+id/settings_toggle"
        android:text="@string/ledger_chat_settings_toggle"
        android:textColor="#3366CC"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/settings_panel"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioGroup
            android:id="@+id/provider_group"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/provider_claude"
                android:text="@string/ledger_chat_provider_claude"
                android:textColor="#000000"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/provider_openai"
                android:text="@string/ledger_chat_provider_openai"
                android:textColor="#000000"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>

        <EditText
            android:id="@+id/api_key_edit"
            android:hint="@string/ledger_chat_api_key_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/model_edit"
            android:hint="@string/ledger_chat_model_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <!-- The one new credential FIELD (no new credential kinds): the mjh.yoga notes ingest
             secret that unlocks Notebot's remote reach (the eight notes_* tools and the
             create_note double-write). Same encrypted store as the API keys. -->
        <EditText
            android:id="@+id/secret_edit"
            android:hint="mjh.yoga notes ingest secret (optional — unlocks the /notes reach)"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_key_button"
            android:text="@string/ledger_chat_save_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/persona_button"
            android:text="@string/ledger_persona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
