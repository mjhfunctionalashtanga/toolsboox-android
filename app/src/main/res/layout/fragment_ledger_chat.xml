<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Title row with the shared ▦ Ledger directory so you can get in/out consistently. -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">
        <TextView
            android:id="@+id/title_text"
            android:text="@string/ledger_chat_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/ledger_button"
            android:src="@drawable/ic_calendar_today"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="34dp" android:layout_height="34dp"/>
    </LinearLayout>

    <TextView
        android:text="@string/ledger_chat_subtitle"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"/>

    <!--
      What was sent, sitting above the answer for the whole visit.

      The passage has always ridden the grounding (`ask_context`); what it never did was show its
      face, so the one thing you could not check while choosing a prompt was WHICH highlight you
      were about to ask about. Four lines and a cross: enough to recognise it, not so much that it
      becomes the page. The cross drops the grounding with it — one gesture, one meaning, no state
      where the model is still reading a passage you thought you had put down.
    -->
    <LinearLayout
        android:id="@+id/passage_banner"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@drawable/eink_edit_bg"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/passage_text"
            android:textColor="#000000"
            android:textSize="14sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/passage_clear"
            android:text="✕"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ledger_chat_passage_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Scope: everything, or pick sections -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox android:id="@+id/scope_books" android:text="@string/ledger_chat_scope_books"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_articles" android:text="@string/ledger_chat_scope_articles"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_feed" android:text="Feed articles"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <CheckBox android:id="@+id/scope_planner" android:text="@string/ledger_chat_scope_planner"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/scope_media" android:text="@string/ledger_chat_scope_media"
            android:checked="true" android:textColor="#000000"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!--
      The prompt presets, as a row of chips directly over the question field.

      They live HERE and not in the collapsed key/model panel where the persona button sits,
      because a preset is spent at the moment of asking: it has to be one tap from the question,
      or typing the question out again is cheaper than finding the saved one. (The persona button
      being buried is a separate sin, and not this pass's to fix — a persona is chosen once and
      then forgotten about, which is the one thing that makes its hiding place survivable.)

      Filled programmatically by [LedgerChatFragment.rebuildPresetRow]: tapping a chip asks it,
      holding one edits or deletes it — hold-to-act, no modes — and the trailing ＋ makes a new one.
    -->
    <HorizontalScrollView
        android:id="@+id/preset_scroll"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/preset_row"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/question_edit"
        android:hint="@string/ledger_chat_hint"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:textSize="17sp"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:gravity="top"
        android:background="@drawable/eink_edit_bg"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/mic_button"
        android:text="@string/ledger_chat_dictate"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/ask_button"
        android:text="@string/ledger_chat_ask"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="@drawable/eink_button_solid"
        android:stateListAnimator="@null"
        android:layout_marginTop="12dp"
        android:paddingVertical="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/answer_text"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!--
          Two keeps, not one. The feed is for something to come back past you again; a text note is
          a thing you have KEPT, titled by the question, with the provenance attached.
        -->
        <Button
            android:id="@+id/save_note_button"
            android:text="@string/ledger_chat_save_note"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_feed_button"
            android:text="@string/ledger_chat_save_feed"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/history_button"
            android:text="@string/ledger_chat_history"
            android:textSize="14sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Collapsible key/model row -->
    <TextView
        android:id="@+id/settings_toggle"
        android:text="@string/ledger_chat_settings_toggle"
        android:textColor="#3366CC"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/settings_panel"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioGroup
            android:id="@+id/provider_group"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/provider_claude"
                android:text="@string/ledger_chat_provider_claude"
                android:textColor="#000000"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/provider_openai"
                android:text="@string/ledger_chat_provider_openai"
                android:textColor="#000000"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>

        <EditText
            android:id="@+id/api_key_edit"
            android:hint="@string/ledger_chat_api_key_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/model_edit"
            android:hint="@string/ledger_chat_model_hint"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/save_key_button"
            android:text="@string/ledger_chat_save_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/persona_button"
            android:text="@string/ledger_persona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
