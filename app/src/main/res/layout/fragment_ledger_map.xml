<?xml version="1.0" encoding="utf-8"?>
<!-- The Map: the connection graph as a picture.

     A plain full-bleed canvas on purpose — unlike the rhizome card, which is a short answer about
     one thing, this is the thing you stare at, and it wants the whole panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- The tucked action rail's gutter — in the layout flow, so the canvas ends where the rail
         begins; setupActionRail re-docks it when the shared side pref says RIGHT. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map_rail"
        android:layout_width="14dp"
        android:layout_height="match_parent"/>

<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Nav line: the ▦ hub left of the navigator, unified with feed / Tasks & Events (the same
         32dp door the feed's top-left just gained). -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingTop="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/goto_button"
            android:src="@drawable/ic_bar_sections"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter" android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/go_to_title"
            android:layout_width="32dp" android:layout_height="32dp"/>
        <ImageView
            android:scaleType="fitXY"
            android:id="@+id/navigatorImageView"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="56dp"
            android:contentDescription="@null"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/map_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/map_subject"
            android:textSize="13sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/map_menu"
            android:text="@string/map_menu"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/map_close"
            android:text="@string/ledger_close"
            android:textSize="15sp"
            android:textColor="#000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- One quiet line that says what the picture IS and what a finger does to it — the map used
         to open as an unlabeled diagram and make you deduce the contract. -->
    <TextView
        android:id="@+id/map_hint"
        android:textSize="13sp"
        android:textColor="#666666"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <FrameLayout
        android:id="@+id/map_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>

</LinearLayout>
