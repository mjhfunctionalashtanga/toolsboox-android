    <!--
        The app's furniture: drawing toolbar, floating pills, their grips, the navigator strip.

        These were inline dp, which is the right instinct on a phone and wrong across this fleet.
        A dp keeps a control the same PHYSICAL size everywhere, while the page is drawn to FIT the
        screen — so on a Palma the page scales to 0.587 and a 46dp button is 120px, and on a Tab X
        the page scales to 1.117 and the same button is 61px. The page doubles, the furniture
        halves, and the controls stop looking like they belong to the page they sit on.

        So they scale with the panel instead. See values-sw600dp for the large-screen set.
    -->
    <dimen name="ledger_toolbar_width">40dp</dimen>
    <dimen name="ledger_toolbar_button">40dp</dimen>
    <dimen name="ledger_pill_button">38dp</dimen>
    <dimen name="ledger_pill_button_padding">7dp</dimen>
    <dimen name="ledger_grip_short">18dp</dimen>
    <dimen name="ledger_grip_long">46dp</dimen>
    <dimen name="ledger_navigator_height">50dp</dimen>
    <dimen name="ledger_nav_button">44dp</dimen>
</resources>
