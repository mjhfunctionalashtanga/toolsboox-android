# --------------------------------------------------------------------------
# Allow list: findings you have looked at and decided may go up.
#   LEDGABLE_PUSH_ALLOW=email,card      every finding of those kinds, this push only
#   <git folder>/ledgable-push-allow    lines "<commit|*> <kind|*> [<path>]", path may use * wildcards
# Moves the matching findings from the hits file to the allowed file.
# --------------------------------------------------------------------------
apply_allow() {
  local hits=$1 allowed=$2 file=$3 kinds p s l r ok wc wk wp tab
  tab=$(printf '\t')
  kinds=",$(printf '%s' "${LEDGABLE_PUSH_ALLOW:-}" | tr -d ' '),"
  : > "$allowed"
  if [ "$kinds" = ",," ] && [ ! -s "$file" ]; then return 0; fi
  : > "$hits.kept"
  while IFS="$tab" read -r p s l r; do
    ok=0
    case "$kinds" in *",$r,"*) ok=1 ;; esac
    if [ "$ok" = 0 ] && [ -s "$file" ]; then
      while read -r wc wk wp; do
        case "$wc" in ''|'#'*) continue ;; esac
        case "$wk" in '*'|"$r") ;; *) continue ;; esac
        case "$wc" in '*') ;; *) case "$s" in "$wc"*) ;; *) continue ;; esac ;; esac
        case "$p" in ${wp:-*}) ok=1; break ;; esac
      done < "$file"
    fi
    if [ "$ok" = 1 ]; then printf '%s\t%s\t%s\t%s\n' "$p" "$s" "$l" "$r" >> "$allowed"
    else printf '%s\t%s\t%s\t%s\n' "$p" "$s" "$l" "$r" >> "$hits.kept"; fi
  done < "$hits"
  mv -f "$hits.kept" "$hits"
}

# --------------------------------------------------------------------------
# Report: group by file, then commit; never prints the matched text. A path
# part that holds an email address is withheld too.
# --------------------------------------------------------------------------
report() {
  local hits=$1 dates=$2
  awk -F '\t' -v dates="$dates" '
  # A path part holds an address when it is one (a folder "someone@example.com") or is one
  # with a file extension on the end (that address, then ".eml"); icon@2x.png is not one.
  function holds_email(c,   x, ext) {
    x = c; ext = ""
    if (match(x, /\.[A-Za-z0-9]+$/)) { ext = tolower(substr(x, RSTART + 1)); x = substr(x, 1, RSTART - 1) }
    if (x ~ /[A-Za-z0-9._%+-]@[A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*(\.[A-Za-z0-9-]+)*\.[A-Za-z][A-Za-z]+$/) return 1
    return c ~ /[A-Za-z0-9._%+-]@[A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*(\.[A-Za-z0-9-]+)*\.[A-Za-z][A-Za-z]+$/ && !(ext in FILEEXT)
  }
  function shown(p,   n, i, a, out) {
    n = split(p, a, "/"); out = ""
    for (i = 1; i <= n; i++) {
      if (holds_email(a[i])) a[i] = (i == n ? "(file name withheld: it holds an email address)" : "(folder name withheld: it holds an email address)")
      out = out (i > 1 ? "/" : "") a[i]
    }
    return out
  }
  BEGIN {
    while ((getline l < dates) > 0) { split(l, d, " "); when[d[1]] = d[2] }
    split("png jpg jpeg gif webp svg pdf heic mov mp3 mp4 m4a wav json xml txt md kt kts java swift html css js ts eml ics vcf zip db log plist strings", fe, " ")
    for (e in fe) FILEEXT[fe[e]] = 1
    L["private_key"] = "a private key"
    L["aws_key"] = "an Amazon (AWS) access key"
    L["google_key"] = "a Google API key"
    L["google_oauth"] = "a Google sign-in secret or token"
    L["stripe_key"] = "a Stripe secret key"
    L["github_token"] = "a GitHub token"
    L["slack_token"] = "a Slack token or webhook"
    L["anthropic_key"] = "an Anthropic API key"
    L["openai_key"] = "an OpenAI-style API key"
    L["service_token"] = "a service API token (SendGrid, npm, Hugging Face, GitLab, Twilio, Mailgun)"
    L["jwt"] = "a signed login token (JWT)"
    L["assigned_secret"] = "a password, secret or API key typed into the file"
    L["php_secret_constant"] = "a PHP constant holding a secret-looking value"
    L["random_secret_value"] = "a long random-looking value next to a key/secret/token/password name"
    L["bearer"] = "a Bearer login token"
    L["basic_auth"] = "a Basic-auth login"
    L["url_credentials"] = "a web address with a password in it"
    L["wp_app_password"] = "a WordPress application password"
    L["fingerprint"] = "a value on your known-secrets list"
    L["email"] = "a real email address"
    L["email_in_file_name"] = "an email address in the file name"
    L["card"] = "card digits (\"ending in\" or \"****\" followed by four digits)"
    L["phone"] = "a phone number in a test/data file"
    L["private_file_name"] = "a file that is usually private (key, keystore, .env, local settings, saved app data)"
  }
  {
    path = $1; sha = $2; ln = $3 + 0; rule = $4
    if (!(path in P)) { P[path] = 1; po[++np] = path }
    k = path SUBSEP sha SUBSEP rule
    if (!(k in K)) { K[k] = 1; ko[++nk] = k; cnt[k] = 0; lines[k] = ""; inside[k] = 0 }
    if (ln > 0) { cnt[k]++; if (cnt[k] <= 6) lines[k] = lines[k] (lines[k] == "" ? "" : ", ") ln }
    else if (ln < 0) inside[k] = 1
    total++
  }
  END {
    for (i = 1; i <= np; i++) {
      printf "\n  %s\n", shown(po[i])
      for (j = 1; j <= nk; j++) {
        split(ko[j], f, SUBSEP)
        if (f[1] != po[i]) continue
        where = ""
        if (cnt[ko[j]] == 1) where = "line " lines[ko[j]] ": "
        else if (cnt[ko[j]] > 1) where = "lines " lines[ko[j]] (cnt[ko[j]] > 6 ? " (+" (cnt[ko[j]] - 6) " more)" : "") ": "
        else if (inside[ko[j]]) where = "inside the file (readable text in a binary file): "
        else if (f[1] == "(commit message)" || f[1] == "(tag message)") where = ""
        else where = "file name: "
        label = (f[3] in L) ? L[f[3]] : f[3]
        printf "      commit %s %s  %s%s [%s]\n", substr(f[2], 1, 10), (f[2] in when ? "(" when[f[2]] ")" : ""), where, label, f[3]
      }
    }
  }' "$hits" >&2
}

# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
MODE=hook
STRICT=0
case "${1:-}" in
  --scan) MODE=scan; shift; if [ "${1:-}" = --strict ]; then STRICT=1; shift; fi ;;
  --install) install_guard ;;
  --status) status_guard ;;
  --allow) shift; allow_add "$@" ;;
  --add-fingerprint) add_fingerprint ;;
  -h|--help) usage; exit 0 ;;
esac

TMP=$(mktemp -d "${TMPDIR:-/tmp}/ledgable-push-guard.XXXXXX") || { say "push guard: cannot make a temp folder"; exit 2; }
trap 'rm -rf "$TMP"' EXIT
: > "$TMP/commits"
: > "$TMP/tags"
: > "$TMP/tips"
: > "$TMP/public"

fail_closed() {
  say ""
  say "Push stopped: the push guard could not work out what is being pushed ($1)."
  say "Nothing was sent. To push anyway: LEDGABLE_PUSH_OVERRIDE=1 git push ..."
  [ "${LEDGABLE_PUSH_OVERRIDE:-}" = 1 ] && exit 0
  exit 1
}

remote_main_tip() {
  # The commit at the remote's default branch, as last fetched.
  local r=$1 ref
  for ref in "refs/remotes/$r/HEAD" "refs/remotes/$r/main" "refs/remotes/$r/master"; do
    git rev-parse -q --verify "$ref^{commit}" 2>/dev/null && return 0
  done
  return 0
}

collect_tags() {
  # An annotated tag (or a tag of a tag) being pushed: its message is read too.
  local o=$1 i=0
  while [ "$i" -lt 8 ] && [ "$(git cat-file -t "$o" 2>/dev/null)" = tag ]; do
    printf '%s\n' "$o" >> "$TMP/tags"
    o=$(git cat-file tag "$o" 2>/dev/null | sed -n '1s/^object //p')
    [ -n "$o" ] || return 0
    i=$((i + 1))
  done
  return 0
}

if [ "$MODE" = scan ]; then
  [ "$#" -gt 0 ] || { usage; exit 2; }
  git rev-list "$@" > "$TMP/commits" || { say "push guard: git rev-list could not read: $*"; exit 2; }
  for a in "$@"; do
    case "$a" in
      --all|--tags) git for-each-ref --format='%(objecttype) %(objectname)' refs/tags |
                      awk '$1 == "tag" { print $2 }' | while IFS= read -r t; do collect_tags "$t"; done ;;
      -*|^*|*..*) ;;
      *) collect_tags "$(git rev-parse -q --verify "$a" 2>/dev/null || :)" ;;
    esac
  done
  if [ "$STRICT" != 1 ]; then
    for r in $(git remote 2>/dev/null); do remote_main_tip "$r" >> "$TMP/tips"; done
  fi
else
  # git runs the hook as: pre-push <remote name> <remote url>, refs on stdin.
  PUSH_REMOTE=${1:-}
  if [ -n "$PUSH_REMOTE" ] && git config --get "remote.$PUSH_REMOTE.url" >/dev/null 2>&1; then
    remote_main_tip "$PUSH_REMOTE" >> "$TMP/tips"
  fi
  while read -r lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    is_zero "$lsha" && continue                       # deleting a remote branch: nothing to check
    [ "$lsha" = "${rsha:-}" ] || collect_tags "$lsha"
    # Only commits that leave this machine with this push: not on the branch being
    # updated and not on any remote branch already (those are public already).
    if is_zero "${rsha:-0}" || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
      git rev-list "$lsha" --not --remotes >> "$TMP/commits" || fail_closed "unreadable $lref"
    else
      printf '%s\n' "$rsha" >> "$TMP/tips"
      git rev-list "$lsha" "^$rsha" --not --remotes >> "$TMP/commits" || fail_closed "unreadable $lref"
    fi
  done
fi
for f in tips commits tags; do
  awk 'NF && !seen[$0]++' "$TMP/$f" > "$TMP/$f.u" && mv "$TMP/$f.u" "$TMP/$f"
done
NCOMMITS=$(wc -l < "$TMP/commits" | tr -d ' ')
NTAGS=$(wc -l < "$TMP/tags" | tr -d ' ')
if [ "$NCOMMITS" -eq 0 ] && [ "$NTAGS" -eq 0 ]; then
  [ "$MODE" = scan ] && say "push guard: no commits in that range."
  exit 0
fi
CHECKED="$NCOMMITS commit(s)"
[ "$NTAGS" -gt 0 ] && CHECKED="$CHECKED and $NTAGS tag message(s)"

# Addresses that are out already or go up anyway with these commits: yours (user.email)
# and the author/committer addresses on the remote and on the commits being pushed.
if [ "$STRICT" != 1 ]; then
  git config --get user.email >> "$TMP/public" 2>/dev/null || :
  if [ -s "$TMP/tips" ]; then
    # shellcheck disable=SC2046
    git log --format='%ae%n%ce' $(cat "$TMP/tips") >> "$TMP/public" 2>/dev/null || :
  fi
  if [ -s "$TMP/commits" ]; then
    git log --no-walk --stdin --format='%ae%n%ce' < "$TMP/commits" >> "$TMP/public" 2>/dev/null || :
  fi
  tr 'A-Z' 'a-z' < "$TMP/public" | awk 'index($0, "@") && !seen[$0]++' > "$TMP/public.u" && mv "$TMP/public.u" "$TMP/public"
fi

FPS=()
while IFS= read -r f; do FPS+=("$f"); done < <(fingerprint_files)

find_python() {
  # GUI git apps often run hooks without /opt/homebrew/bin on PATH: look there too.
  local p
  for p in "$(command -v python3 2>/dev/null || :)" /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    [ -n "$p" ] && [ -x "$p" ] || continue
    "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 6) else 1)' >/dev/null 2>&1 && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

: > "$TMP/hits"
ENGINE=full
PY=""
[ "${LEDGABLE_GUARD_NO_PYTHON:-}" = 1 ] || PY=$(find_python || :)
if [ -n "$PY" ]; then
  "$PY" -c "$PY_SCANNER" "$TMP/commits" "$TMP/hits" "$TMP/tips" "$TMP/public" "$TMP/tags" ${FPS[@]+"${FPS[@]}"} ||
    fail_closed "the scanner stopped with an error"
else
  ENGINE=basic
  awk_scan "$TMP/commits" "$TMP/hits" "$TMP/tips" "$TMP/public" "$TMP/tags" ${FPS[@]+"${FPS[@]}"} ||
    fail_closed "the scanner stopped with an error"
fi

NOTE=""
[ "$ENGINE" = basic ] && NOTE=" (basic checks only: python3 not found)"

COMMON=$(common_dir)
ALLOW_FILE="${COMMON:+$COMMON/$ALLOW_NAME}"
apply_allow "$TMP/hits" "$TMP/allowed" "${ALLOW_FILE:-/dev/null}"
NALLOWED=$(cut -f1,2,4 "$TMP/allowed" | sort -u | wc -l | tr -d ' ')
allowed_note() {
  [ "$NALLOWED" -gt 0 ] || return 0
  say "($NALLOWED finding(s) let through by ${LEDGABLE_PUSH_ALLOW:+LEDGABLE_PUSH_ALLOW=$LEDGABLE_PUSH_ALLOW or }your allow list${ALLOW_FILE:+, $ALLOW_FILE}.)"
}

if [ ! -s "$TMP/hits" ]; then
  if [ "$MODE" = scan ]; then say "push guard: checked $CHECKED$NOTE: nothing private found."; allowed_note
  elif [ "$NALLOWED" -gt 0 ]; then allowed_note; fi
  exit 0
fi

cut -f2 "$TMP/hits" | awk '!s[$0]++' | git log --no-walk --stdin --format='%H %ad' --date=short > "$TMP/dates" 2>/dev/null || : > "$TMP/dates"
NHITS=$(cut -f1,2,4 "$TMP/hits" | sort -u | wc -l | tr -d ' ')
NFILES=$(cut -f1 "$TMP/hits" | sort -u | wc -l | tr -d ' ')

if [ "$MODE" = scan ]; then
  say ""
  say "Push guard dry run: $CHECKED checked$NOTE, $NHITS finding(s) in $NFILES place(s)."
  say "(Nothing was pushed. Only file names, commits and line numbers are shown.)"
  report "$TMP/hits" "$TMP/dates"
  say ""
  allowed_note
  exit 1
fi

if [ "${LEDGABLE_PUSH_OVERRIDE:-}" = 1 ]; then
  say ""
  say "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  say "!!  LEDGABLE_PUSH_OVERRIDE=1 -- PUSHING ANYWAY. The guard found $NHITS"
  say "!!  thing(s) that look private, and they are going up now:"
  say "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  report "$TMP/hits" "$TMP/dates"
  say ""
  say "!!  Override used. If any of that was a real secret, change it now."
  say "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  say ""
  exit 0
fi

say ""
say "========================================================================"
say "  Push stopped: something private would go up with these commits."
say "========================================================================"
say "Checked $CHECKED$NOTE. Nothing has been sent."
report "$TMP/hits" "$TMP/dates"
say ""
allowed_note
say "What to do:"
say "  * Take it out of that commit (or swap in a made-up example such as"
say "    someone@example.com), then push again. Removing it in a later commit"
say "    is not enough: the earlier commit still carries it."
say "  * Looked at it and it may go up (your own address, say)? Let that one"
say "    finding through, using the commit and the [kind] shown above:"
say "        scripts/githooks/pre-push --allow <commit> <kind> [<path>]"
say "  * See what a range holds without pushing:"
say "        scripts/githooks/pre-push --scan HEAD --not --remotes"
say "  * Sure all of it is fine? Push once with:  LEDGABLE_PUSH_OVERRIDE=1 git push ..."
say ""
exit 1
