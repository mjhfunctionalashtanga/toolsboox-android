hits = []
seen = set()

def hit(path, sha, line, rule):
    k = (path, sha, line, rule)
    if k not in seen:
        seen.add(k)
        hits.append(k)

REAL_SHORT_DOMAINS = {'x.com', 'q.com', 'i.ua'}

def email_allowed(local, dom, line, kind):
    a = (local + '@' + dom).lower()
    d = dom.lower()
    if a == 'noreply@anthropic.com':
        return True
    if a in PUBLIC_EMAILS:
        return True
    if d == 'users.noreply.github.com' or d.endswith('.users.noreply.github.com'):
        return True
    if d in ('example.com', 'example.org', 'example.net') or d.endswith(('.example.com', '.example.org', '.example.net')):
        return True
    if d.rsplit('.', 1)[-1] in ('test', 'example', 'invalid', 'localhost', 'local'):
        return True
    if kind == 'msg' and TRAILER.match(line):    # Co-Authored-By: in a commit message
        return True
    return False

MSGID_LINE = re.compile(r'^\s*(?:message-id|in-reply-to|references|resent-message-id|x-message-id)\s*:', re.I)

def not_a_mailbox(local, dom):
    """Shapes that look like an address but cannot reach a person."""
    d = dom.lower()
    labels = d.split('.')
    if d == 'mail.gmail.com':                    # the host part of Gmail message ids
        return True
    if len(local) >= 24 and sum(c.isdigit() for c in local) >= 3 and entropy(local) >= 4.0:
        return True                              # a random message id, not a name
    if len(labels) == 2 and len(labels[0]) == 1 and (d not in REAL_SHORT_DOMAINS or len(local) <= 2):
        return True                              # a@x.org, b@y.com, s@x.com: made up for a test
    if d in ('gmail.com', 'googlemail.com') and len(local.split('+')[0].replace('.', '')) < 6:
        return True                              # Gmail names are at least 6 letters long
    return False

EMAIL_HITS = collections.OrderedDict()   # (path, sha, line, rule) -> addresses (kept in memory only)

def check_emails(text, path, sha, ln, rule='email', kind='file'):
    if MSGID_LINE.match(text):
        return
    found = set()
    for m in EMAIL.finditer(text):
        local, dom, tld = m.group('local'), m.group('dom'), m.group('tld')
        if tld.lower() in FILE_EXT_TLDS:
            continue
        if local.lower() in CODE_LABELS:
            continue
        if re.search(r'[a-z][A-Z]', tld):        # camelCase: a code label like this@Foo.bar
            continue
        end = m.end()
        if end < len(text) and text[end] == ':' and local.lower() == 'git':
            continue                             # git@github.com:owner/repo
        if email_allowed(local, dom, text, kind) or not_a_mailbox(local, dom):
            continue
        found.add((local + '@' + dom).lower())
    if found:
        EMAIL_HITS.setdefault((path, sha, ln, rule), set()).update(found)

def settle_emails():
    """Keep an email finding unless every address on that line is already
    published on the remote. One `git grep` over the remote's tips answers it."""
    public = set()
    wanted = sorted(set().union(*EMAIL_HITS.values())) if EMAIL_HITS else []
    if wanted and PUBLIC_TIPS:
        try:
            p = subprocess.run(['git', 'grep', '-I', '-i', '-w', '-o', '-h', '-F', '--no-color', '-f', '-']
                               + PUBLIC_TIPS + ['--'],
                               input='\n'.join(wanted).encode('utf-8'),
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if p.returncode in (0, 1):
                public = {s.strip().lower() for s in p.stdout.decode('utf-8', 'replace').splitlines()}
        except OSError:
            public = set()
    for (path, sha, ln, rule), addrs in EMAIL_HITS.items():
        if not addrs <= public:
            hit(path, sha, ln, rule)

def candidates(line):
    out = set()
    s = line.strip()
    if 20 <= len(s) <= 80:
        out.add(s)
    for rx in (r'[A-Za-z0-9_\-]+', r'[A-Za-z0-9_\-+/=.~]+', r'[^\s\'"`]+'):
        for m in re.finditer(rx, line):
            t = m.group(0)
            for u in (t, t.strip('([{<,;:)]}>.'), re.split(r'[=:]', t)[-1].strip('([{<,;:)]}>.')):
                if 20 <= len(u) <= 80:
                    out.add(u)
    for g in quoted_literals(line):
        if 20 <= len(g) <= 80:
            out.add(g)
    return out

def fingerprinted(text):
    for c in candidates(text):
        if hashlib.sha256(c.encode('utf-8', 'surrogateescape')).hexdigest() in FINGERPRINTS:
            return True
    return False

def check_text(text, path, sha, ln, kind, prev_key=None):
    """kind: 'file' (an added line of path) or 'msg' (a commit or tag message line).
    prev_key: the plist <key> name on the line just before, if any."""
    if FINGERPRINTS and fingerprinted(text):
        hit(path, sha, ln, 'fingerprint')
    ext = ext_of(path) if kind == 'file' else '.txt'
    if ext in PHONE_EXT and kind == 'file':
        for rx in PHONE:
            m = None
            for m in rx.finditer(text):
                if 'ex' in rx.groupindex and m.group('ex') == '555':
                    continue                     # 555 numbers are the made-up kind
                digits = re.sub(r'\D', '', m.group(0))
                if 10 <= len(digits) <= 15:
                    hit(path, sha, ln, 'phone')
                    break
    if not TRIGGER.search(text) and not prev_key:
        return
    token_hit = False
    for rule, rx in TOKEN_RULES:
        if rx.search(text):
            hit(path, sha, ln, rule)
            token_hit = True
    if '@' in text:
        check_emails(text, path, sha, ln, kind=kind)
    for rx in CARD:
        if rx.search(text):
            hit(path, sha, ln, 'card')
            break
    if not token_hit:
        rule = generic_secret(text, ext, kind, prev_key)
        if rule:
            hit(path, sha, ln, rule)

def min_len_for(name):
    return 20 if STRONG_NAME.search(name.strip('-_.')) else 32

def generic_secret(text, ext, kind, prev_key=None):
    """The first secret-shaped thing on the line that has no fixed prefix, or None."""
    for m in URL_CRED.finditer(text):
        if looks_secret(m.group('p'), 6):
            return 'url_credentials'
    for m in BEARER.finditer(text):
        t = m.group('tok')
        if any(c.isdigit() for c in t) and any(c.isalpha() for c in t) and not is_placeholder(t):
            return 'bearer'
    for m in BASIC.finditer(text):
        if not is_placeholder(m.group('tok')):
            return 'basic_auth'
    for m in WP_APP_PW.finditer(text):
        pw = m.group('pw')
        if re.search(r'[A-Z]', pw) and re.search(r'[a-z]', pw) and re.search(r'\d', pw):
            return 'wp_app_password'
    for rx in (PHP_DEFINE, PHP_CONST):
        for m in rx.finditer(text):
            if php_secret_value(m.group('val')):
                return 'php_secret_constant'
    # random-looking values given to a key/secret/token/password name, quoted or not
    for rx in (ENTROPY_ASSIGN, UNQUOTED_ASSIGN):
        for m in rx.finditer(text):
            name = m.group('name')
            if SECRETISH_NAME.search(name) and random_looking(m.group('val'), min_len_for(name)):
                return 'random_secret_value'
    for m in ADB_EXTRA.finditer(text):
        if SECRETISH_NAME.search(m.group('name')) and random_looking(m.group('val'), 20):
            return 'random_secret_value'
    if '<' in text:
        for m in XML_TEXT.finditer(text):
            if m.group('tag').lower() != 'key' and SECRETISH_NAME.search(m.group('tag') + ' ' + (m.group('attrs') or '')) \
                    and random_looking(m.group('val'), 20):
                return 'random_secret_value'
        for m in PLIST_STRING.finditer(text):
            before = list(PLIST_KEY.finditer(text, 0, m.start()))
            name = before[-1].group('name') if before else prev_key
            if name and SECRETISH_NAME.search(name) and random_looking(m.group('val'), 20):
                return 'random_secret_value'
    # ...or written on the same line as one
    if SECRETISH_LINE.search(text):
        for g in quoted_literals(text):
            if random_looking(g):
                return 'random_secret_value'
    # password= / secret= / api_key= with a real-looking value
    for m in ASSIGN_NAME.finditer(text):
        op = m.group('op')
        if op in ('==', '===', '!=', '!=='):
            continue
        r = text[m.end():].lstrip()
        r = re.sub(r'^[@rbuf]{1,2}(?=["\'`])', '', r)
        val = None
        if r[:1] in ('"', "'", '`'):
            q = r[0]
            end = r.find(q, 1)
            val = r[1:end] if end > 0 else r[1:]
        elif m.group('pre') or ext in CONFIG_EXT or kind == 'msg':
            mm = re.match(r'[^\s,;\'"`)\]}<>&#]+', r)
            val = mm.group(0) if mm else None
            if val and '(' in val:
                val = None                       # code (a function call), not a value
        if val and looks_secret(val, 6):
            return 'assigned_secret'
        # In a real settings file a plain-word password is still a password.
        if val and ext in PLAIN_CONFIG_EXT and len(val) >= 8 and re.fullmatch(r'[A-Za-z]+', val) \
                and not is_placeholder(val) and not NAMEISH_WORDS.search(val):
            return 'assigned_secret'
    return None

PLAIN_CONFIG_EXT = {'.env', '.properties', '.ini', '.cfg', '.conf', '.toml', '.yml', '.yaml',
                    '.netrc', '.xcconfig'}

def check_name(path, sha):
    base = os.path.basename(path)
    lb = BACKUP_SUFFIX.sub('', base.lower()) or base.lower()   # local.properties.bak is still private
    ext = os.path.splitext(lb)[1]
    bad = False
    if lb in SENSITIVE_BASENAMES or ext in SENSITIVE_EXT:
        bad = True
    elif re.fullmatch(r'.+\.(db|db3|sqlite3?)-(wal|shm|journal)', lb):
        bad = True
    elif re.fullmatch(r'\.env(\..+)?', lb) and not re.search(r'\.(example|sample|template|dist|defaults)$', lb):
        bad = True
    elif re.fullmatch(r'secrets?\.(json|ya?ml|properties|env|txt|plist|xcconfig|toml|ini)', lb):
        bad = True
    elif re.fullmatch(r'(client_secret|service[-_]account)[\w.\-]*\.json', lb):
        bad = True
    if bad:
        hit(path, sha, 0, 'private_file_name')
    check_emails(path, path, sha, 0, rule='email_in_file_name', kind='name')

# ---------------------------------------------------------------- binary files
BINARY_LIMIT = 64 * 1024 * 1024
PRINTABLE = re.compile(rb'[\x20-\x7e]{16,}')
# a quick first look for the token beginnings, so a large binary is read in about a second
TOKEN_PREFIX = re.compile(r'AKIA|ASIA|ABIA|ACCA|AIza|GOCSPX-|ya29\.|1//0|[sr]k_(?:live|test)_|whsec_|gh[pousr]_|github_pat_|'
                          r'xox[abposr]-|hooks\.slack\.com|sk-|SG\.|npm_|hf_|glpat-|SK[0-9a-f]{32}|key-[0-9a-f]{32}|eyJ|-----BEGIN')

def blob_findings(data):
    found = []
    listed = False
    for m in PRINTABLE.finditer(data):
        t = m.group(0).decode('ascii')
        if TOKEN_PREFIX.search(t):
            for rule, rx in TOKEN_RULES:
                if rule not in found and rx.search(t):
                    found.append(rule)
        if FINGERPRINTS and not listed and fingerprinted(t):
            listed = True
            found.append('fingerprint')
    return found

def scan_binaries(binaries):
    """Binary files the commits add or change: their readable text is checked for
    the fixed-beginning tokens and your known-secrets list (line -1 in the report).
    Each distinct file content is read once, through one git process."""
    if not binaries:
        return
    specs = ''.join('%s:%s\n' % (s, p) for s, p in binaries)
    try:
        chk = subprocess.run(['git', 'cat-file', '--batch-check=%(objectname) %(objecttype) %(objectsize)'],
                             input=specs.encode('utf-8', 'surrogateescape'),
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return
    todo = collections.OrderedDict()             # content id -> the (commit, path) places holding it
    for (sha, path), row in zip(binaries, chk.stdout.decode('utf-8', 'replace').splitlines()):
        parts = row.split()
        if len(parts) == 3 and parts[1] == 'blob' and parts[2].isdigit() and int(parts[2]) <= BINARY_LIMIT:
            todo.setdefault(parts[0], []).append((sha, path))
    if not todo:
        return
    try:
        cat = subprocess.Popen(['git', 'cat-file', '--batch'], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return
    try:
        for oid, places in todo.items():
            cat.stdin.write((oid + '\n').encode('ascii'))
            cat.stdin.flush()
            head = cat.stdout.readline().split()
            if len(head) != 3 or not head[2].isdigit():
                continue                         # "<id> missing"
            data = cat.stdout.read(int(head[2]))
            cat.stdout.read(1)                   # the newline after each object
            for rule in blob_findings(data):
                for sha, path in places:
                    hit(path, sha, -1, rule)
    finally:
        try:
            cat.stdin.close()
        except OSError:
            pass
        cat.wait()

# ---------------------------------------------------------------- tag messages
def scan_tags():
    for t in TAGS:
        try:
            p = subprocess.run(['git', 'cat-file', 'tag', t], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            continue
        if p.returncode != 0:
            continue
        parts = p.stdout.decode('utf-8', 'replace').split('\n\n', 1)
        for line in (parts[1] if len(parts) > 1 else '').splitlines():
            if re.match(r'-----BEGIN [A-Z ]*SIGNATURE-----', line):
                break
            if line.strip():
                check_text(line, '(tag message)', t, 0, 'msg')

# ---------------------------------------------------------------- git stream
def unquote_path(p):
    p = p.strip()
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        body = p[1:-1]
        try:
            return body.encode('latin-1', 'backslashreplace').decode('unicode_escape').encode('latin-1').decode('utf-8', 'replace')
        except Exception:
            return body
    return p

def header_path(s):
    # "a/P b/P" -> P (same path both sides, the common case incl. new files)
    if s.startswith('"'):
        parts = re.findall(r'"(?:[^"\\]|\\.)*"|\S+', s)
        if len(parts) >= 2:
            return re.sub(r'^b/', '', unquote_path(parts[-1]))
    n = len(s)
    if (n - 5) % 2 == 0:
        L = (n - 5) // 2
        if s[:2] == 'a/' and s[2 + L:5 + L] == ' b/' and s[2:2 + L] == s[5 + L:]:
            return s[2:2 + L]
    i = s.rfind(' b/')
    return s[i + 3:] if i >= 0 else s

def clean(p):
    return p.replace('\t', ' ').replace('\n', ' ')

cmd = ['git', '-c', 'core.quotePath=false', '-c', 'diff.noprefix=false', '-c', 'diff.mnemonicPrefix=false',
