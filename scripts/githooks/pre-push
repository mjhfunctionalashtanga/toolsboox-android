#!/usr/bin/env bash
# Ledgable push guard.
#
# Runs before every `git push` (once turned on with --install) and stops the
# push when one of the commits about to leave this machine contains something
# that looks like a secret (keys, tokens, passwords) or personal data (real
# email addresses, card digits, phone numbers in test files).
#
# It reads only what is new in this push: the lines each commit adds, the names
# of files it adds or renames, readable text inside binary files it adds, its
# commit message, and the message of any annotated tag being pushed. It never
# prints the matched text, only the file, the commit and the line number.
#
#   scripts/githooks/pre-push --install            turn it on for every worktree of this repository
#   scripts/githooks/pre-push --status             is it on here?
#   scripts/githooks/pre-push --scan <revisions>   check without pushing
#   scripts/githooks/pre-push --scan --strict ...  the same, with no "already public" passes
#   scripts/githooks/pre-push --add-fingerprint    add a known secret's fingerprint
#   scripts/githooks/pre-push --allow <commit|*> <kind|*> [<path>]   let one finding through
#   LEDGABLE_PUSH_ALLOW=email git push ...         let every finding of these kinds through
#   LEDGABLE_PUSH_OVERRIDE=1 git push ...          push anyway (loud)
#
# python3 is used when present (full checks). Without it a smaller set of
# checks runs in awk. See README.md next to this file.

set -u

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
SELF="$HOOK_DIR/$(basename "$0")"
FP_NAME=known-secret-fingerprints             # the old place, next to this file (still read)
SHARED_FP_NAME=ledgable-secret-fingerprints   # in the repository's shared git folder
ALLOW_NAME=ledgable-push-allow                # findings you let through, same folder
SNAPSHOT_NAME=ledgable-push-guard             # a copy of this file, same folder
LAUNCHER_MARK=ledgable-push-guard-launcher
KINDS="private_key aws_key google_key google_oauth stripe_key github_token slack_token anthropic_key
openai_key service_token jwt assigned_secret php_secret_constant random_secret_value bearer basic_auth
url_credentials wp_app_password fingerprint email email_in_file_name card phone private_file_name"

say() { printf '%s\n' "$*" >&2; }

is_zero() { case "${1:-}" in ''|*[!0]*) return 1 ;; *) return 0 ;; esac; }

common_dir() {
  # The repository's shared git folder: the same for the main checkout and every worktree.
  local d
  d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ -n "$d" ] && { printf '%s\n' "$d"; return 0; }
  d=$(git rev-parse --git-common-dir 2>/dev/null) && [ -n "$d" ] && (cd "$d" 2>/dev/null && pwd)
}

main_checkout() {
  # The main working tree of this repository (shared by all worktrees).
  local common
  common=$(common_dir) || return 0
  case "$common" in */.git) printf '%s\n' "${common%/.git}" ;; esac
}

fingerprint_files() {
  local seen="" f main common top
  common=$(common_dir)
  main=$(main_checkout)
  top=$(git rev-parse --show-toplevel 2>/dev/null || :)
  for f in "${common:+$common/$SHARED_FP_NAME}" \
           "$HOOK_DIR/$FP_NAME" \
           "${top:+$top/scripts/githooks/$FP_NAME}" \
           "${main:+$main/scripts/githooks/$FP_NAME}" \
           "${LEDGABLE_PUSH_FINGERPRINTS:-}"; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    case "$seen" in *"|$f|"*) continue ;; esac
    seen="$seen|$f|"
    printf '%s\n' "$f"
  done
}

sha256_of_stdin() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 | awk '{print $NF}'
  elif command -v python3 >/dev/null 2>&1; then python3 -c 'import sys,hashlib;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'
  else return 1
  fi
}

add_fingerprint() {
  local common file secret fp
  common=$(common_dir)
  # Inside the shared git folder the list is read by every worktree and can never be committed.
  if [ -n "$common" ]; then file="$common/$SHARED_FP_NAME"; else file="$HOOK_DIR/$FP_NAME"; fi
  if [ ! -t 0 ]; then
    say "Run this in a terminal: it asks for the secret without showing it."
    exit 2
  fi
  printf 'Paste the secret (it will not be shown), then press Enter: ' >&2
  IFS= read -rs secret
  printf '\n' >&2
  if [ "${#secret}" -lt 20 ] || [ "${#secret}" -gt 80 ]; then
    say "Note: only values 20 to 80 characters long are compared; this one is ${#secret}."
  fi
  fp=$(printf '%s' "$secret" | sha256_of_stdin) || { say "No sha256 tool found (shasum, sha256sum, openssl or python3)."; exit 2; }
  secret=""
  if [ -f "$file" ] && grep -qx "$fp" "$file" 2>/dev/null; then
    say "Already on the list: $file"
    exit 0
  fi
  (umask 077; printf '%s\n' "$fp" >> "$file") || { say "Could not write $file"; exit 2; }
  say "Added one fingerprint to $file"
  if [ -z "$common" ] && ! git -C "$HOOK_DIR" check-ignore -q "$file" 2>/dev/null; then
    say "WARNING: $file is not ignored by git. Add 'scripts/githooks/$FP_NAME' to .gitignore before committing."
  fi
  exit 0
}

write_launcher() {
  cat <<EOF
#!/bin/sh
# $LAUNCHER_MARK: written by scripts/githooks/pre-push --install (run it again to refresh).
# Every worktree of this repository pushes through this file. It runs the push guard
# from the worktree's own scripts/githooks/ folder, or else the copy kept in this git
# folder. If neither is there the push is stopped: it is never let through unchecked.
top=\$(git rev-parse --show-toplevel 2>/dev/null)
common=\$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
for g in "\${top:+\$top/scripts/githooks/pre-push}" "\${common:+\$common/$SNAPSHOT_NAME}"; do
  if [ -n "\$g" ] && [ -f "\$g" ]; then exec bash "\$g" "\$@"; fi
done
echo "" >&2
echo "Push stopped: the push guard is missing (no scripts/githooks/pre-push here and no copy in \${common:-the git folder})." >&2
echo "Nothing was sent. Put it back by running scripts/githooks/pre-push --install from a checkout that has it," >&2
echo "or push once with: LEDGABLE_PUSH_OVERRIDE=1 git push ..." >&2
[ "\${LEDGABLE_PUSH_OVERRIDE:-}" = 1 ] && exit 0
exit 1
EOF
}

install_guard() {
  local common hooks launcher snap hp lhp tmp
  common=$(common_dir)
  [ -n "$common" ] || { say "push guard: run --install inside the repository."; exit 2; }
  hooks="$common/hooks"; launcher="$hooks/pre-push"; snap="$common/$SNAPSHOT_NAME"
  if [ -e "$launcher" ] && ! grep -q "$LAUNCHER_MARK" "$launcher" 2>/dev/null; then
    say "push guard: $launcher already exists and is not the guard's launcher."
    say "Move it aside (or fold it in by hand), then run --install again. Nothing was changed."
    exit 2
  fi
  # The old way (core.hooksPath pointing at a scripts/githooks folder) let pushes through
  # unchecked whenever that folder was missing; take it out.
  lhp=$(git config --local --get core.hooksPath 2>/dev/null || :)
  case "${lhp%/}" in
    */scripts/githooks|scripts/githooks) ;;
    *) lhp="" ;;
  esac
  hp=$(git config --get core.hooksPath 2>/dev/null || :)
  if [ -n "$hp" ] && [ "$hp" != "$lhp" ]; then
    say "push guard: core.hooksPath is set to $hp, so git never looks in $hooks."
    say "Remove that setting (git config --unset core.hooksPath, at the level where it is set), then run --install again."
    say "Nothing was changed."
    exit 2
  fi
  if [ -n "$lhp" ]; then
    git config --local --unset-all core.hooksPath && say "Removed the old core.hooksPath setting ($lhp)."
    hp=$(git config --get core.hooksPath 2>/dev/null || :)
    if [ -n "$hp" ]; then
      say "push guard: core.hooksPath is also set to $hp at another level, so git never looks in $hooks."
      say "Remove that setting too, then run --install again."
      exit 2
    fi
  fi
  mkdir -p "$hooks" || { say "push guard: could not make $hooks"; exit 2; }
  if [ "$SELF" != "$snap" ]; then
    tmp="$snap.tmp.$$"
    if ! { cp "$SELF" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$snap"; }; then
      rm -f "$tmp"; say "push guard: could not write $snap"; exit 2
    fi
  fi
  tmp="$launcher.tmp.$$"
  if ! { write_launcher > "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$launcher"; }; then
    rm -f "$tmp"; say "push guard: could not write $launcher"; exit 2
  fi
  say "Push guard is on for every worktree of this repository."
  say "  runs before each push:   $launcher"
  say "  copy used when a worktree has no scripts/githooks/: $snap (refreshed by --install)"
  say "  your known-secrets list: $common/$SHARED_FP_NAME"
  exit 0
}

status_guard() {
  local common where hp top used n=0 a=0 c f on=1
  common=$(common_dir)
  [ -n "$common" ] || { say "push guard: not inside a git repository."; exit 2; }
  hp=$(git config --get core.hooksPath 2>/dev/null || :)
  where=$(git rev-parse --path-format=absolute --git-path hooks/pre-push 2>/dev/null || git rev-parse --git-path hooks/pre-push)
  [ -n "$hp" ] && say "core.hooksPath is set ($hp), so git looks for the hook there."
  if [ -f "$where" ] && grep -q "$LAUNCHER_MARK" "$where" 2>/dev/null; then
    top=$(git rev-parse --show-toplevel 2>/dev/null || :)
    if [ -n "$top" ] && [ -f "$top/scripts/githooks/pre-push" ]; then used="$top/scripts/githooks/pre-push"
    elif [ -f "$common/$SNAPSHOT_NAME" ]; then used="$common/$SNAPSHOT_NAME"
    else used=""; fi
    if [ -n "$used" ]; then say "On: pushes from here are checked by $used"
    else say "On, but the guard itself is missing here, so pushes from here are stopped. Run --install again."; on=0; fi
  elif [ -f "$where" ]; then
    say "Not the guard: git runs $where before a push. Run scripts/githooks/pre-push --install to see what to do."; on=0
  else
    say "Off: git finds no pre-push hook ($where), so pushes are not checked."
    say "Turn it on with: scripts/githooks/pre-push --install"; on=0
  fi
  while IFS= read -r f; do
    c=$(grep -cE '^[[:space:]]*[0-9a-fA-F]{64}' "$f" 2>/dev/null)
    n=$((n + ${c:-0}))
  done < <(fingerprint_files)
  [ -f "$common/$ALLOW_NAME" ] && a=$(grep -cvE '^[[:space:]]*(#|$)' "$common/$ALLOW_NAME" 2>/dev/null || :)
  say "Known-secrets list: ${n:-0} fingerprint(s). Allow list: ${a:-0} line(s) ($common/$ALLOW_NAME)."
  [ "$on" = 1 ]; exit $?
}

allow_add() {
  local c=${1:-} k=${2:-} p=${3:-*} common file
  common=$(common_dir)
  [ -n "$common" ] || { say "push guard: run --allow inside the repository."; exit 2; }
  file="$common/$ALLOW_NAME"
  c=$(printf '%s' "$c" | tr 'A-F' 'a-f')
  case "$c" in
    '*') ;;
    *) printf '%s' "$c" | grep -Eq '^[0-9a-f]{7,64}$' || { say "usage: pre-push --allow <commit (7+ characters) or *> <kind or *> [<path, * wildcards allowed>]"; exit 2; } ;;
  esac
  case " $(printf '%s' "$KINDS" | tr '\n' ' ') * " in
    *" $k "*) ;;
    *) say "push guard: unknown kind \"$k\". Kinds are shown in [brackets] in the guard's report:"; say "  $(printf '%s' "$KINDS" | tr '\n' ' ')"; exit 2 ;;
  esac
  printf '%s %s %s\n' "$c" "$k" "$p" >> "$file" || { say "Could not write $file"; exit 2; }
  say "Added to $file:  $c $k $p"
  exit 0
}

usage() {
  cat >&2 <<'EOF'
Ledgable push guard

  Turn it on (once per repository):  scripts/githooks/pre-push --install
  Is it on here?                     scripts/githooks/pre-push --status
  Check without pushing:             scripts/githooks/pre-push --scan HEAD --not --remotes
                                     scripts/githooks/pre-push --scan origin/main..HEAD
  Before making a repository public: scripts/githooks/pre-push --scan --strict --all
  Add a known secret:                scripts/githooks/pre-push --add-fingerprint
  Let one finding through:           scripts/githooks/pre-push --allow <commit> <kind> [<path>]
  Let a kind through, once:          LEDGABLE_PUSH_ALLOW=email git push ...
  Push anyway, once:                 LEDGABLE_PUSH_OVERRIDE=1 git push ...
EOF
}

# --------------------------------------------------------------------------
# Full scanner (python3). Reads the commit list, writes one hit per line:
#   path <TAB> commit <TAB> line-number (0 = file name / message, -1 = inside a binary file) <TAB> rule
# --------------------------------------------------------------------------
IFS= read -r -d '' PY_SCANNER <<'PYEOF' || :
import sys, os, re, math, hashlib, subprocess, collections

commits_file, hits_file, tips_file, public_file, tags_file = sys.argv[1:6]
fp_files = [f for f in sys.argv[6:] if f]

def read_list(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            return [t.strip() for t in fh if t.strip()]
    except OSError:
        return []

SHA_RX = re.compile(r'[0-9a-f]{40,64}')
# Commits already on the remote (its main branch, the branch being pushed to).
# An email address that is already published there is not news; it is let through.
PUBLIC_TIPS = [t for t in read_list(tips_file) if SHA_RX.fullmatch(t)]
# Addresses that are out already or go up anyway: your user.email, and the author and
# committer addresses of the commits being pushed and of those already on the remote.
PUBLIC_EMAILS = {t.lower() for t in read_list(public_file) if '@' in t}
# Annotated tags being pushed: their messages are read too.
TAGS = [t for t in read_list(tags_file) if SHA_RX.fullmatch(t)]

# ---------------------------------------------------------------- fingerprints
FINGERPRINTS = set()
for f in fp_files:
    try:
        with open(f, encoding='utf-8', errors='replace') as fh:
            for n, raw in enumerate(fh, 1):
                s = raw.strip()
                if not s or s.startswith('#'):
                    continue
                s = s.split()[0].lower()
                if re.fullmatch(r'[0-9a-f]{64}', s):
                    FINGERPRINTS.add(s)
                else:
                    sys.stderr.write('push guard: line %d of %s is not a sha256 fingerprint '
                                     '(if it is a raw secret, replace it with its fingerprint)\n' % (n, f))
    except OSError:
        pass

# ---------------------------------------------------------------- helpers
def entropy(s):
    if not s:
        return 0.0
    c = collections.Counter(s)
    n = float(len(s))
    return -sum(v / n * math.log(v / n, 2) for v in c.values())

PLACEHOLDER_EXACT = {
    'null', 'none', 'nil', 'undefined', 'true', 'false', 'password', 'passwd', 'secret',
    'apikey', 'api_key', 'api-key', 'token', 'string', 'test', 'testing', 'demo', 'admin',
    'default', 'empty', 'unset', 'required', 'optional', 'anything', 'unused', 'ollama',
    'lm-studio', 'lmstudio', 'not-needed', 'not_needed', 'notneeded', 'no-key', 'nokey',
}
PLACEHOLDER_PARTS = (
    'changeme', 'change_me', 'change-me', 'replace', 'your', 'example', 'sample',
    'placeholder', 'dummy', 'fake', 'redacted', 'xxxx', '****', '....', '<', '>',
    '{{', '}}', '${', '$(', '%s', '%@', '%d', '%(', '\\(', 'todo', 'tbd', 'insert_',
    'not-a-real', 'not_a_real', 'notreal', 'secret-here', 'key-here', 'token-here',
)
NAMEISH_WORDS = re.compile(r'(pass|secret|key|token|pref|setting|field|label|hint|title|name|auth|cred|cache|store|header|param|column|meta)', re.I)

def is_placeholder(v):
    s = v.strip()
    if len(s) < 6:
        return True
    l = s.lower()
    if l in PLACEHOLDER_EXACT:
        return True
    if any(p in l for p in PLACEHOLDER_PARTS):
        return True
    if s[0] in '$%{[(@#':
        return True
    if re.fullmatch(r'[xX*\u2022.\-_0#=]+', s) or len(set(s)) <= 2:
        return True
    if re.search(r'\s', s):                      # prose / UI text
        return True
    if '://' in s:                               # a URL (credentials in URLs have their own rule)
        return True
    if re.fullmatch(r'[A-Z][A-Z0-9_]*', s) and '_' in s:          # ENV_VAR_NAME
        return True
    if re.fullmatch(r'[a-z][a-z0-9]*(?:[_.\-:/][a-z0-9]+)*', s) and NAMEISH_WORDS.search(s):
        return True                              # a settings/meta key name such as "imap_password"
    if re.fullmatch(r'[a-z]+(?:[A-Z][a-z0-9]*)+', s) and NAMEISH_WORDS.search(s):
        return True                              # camelCase identifier
    if re.match(r'(R\.string|BuildConfig|getString|System\.getenv|process\.env|os\.environ|ENV\[|env\(|getenv|Keychain|UserDefaults|NSLocalizedString)', s):
        return True
    if re.fullmatch(r'/?(?:[a-z0-9_.\-]+/)+[a-z0-9_.\-]*', s) and re.search(r'[a-z]{3,}', s):
        return True                              # a file path such as scripts/githooks/pre-push
    if not re.search(r'\d', s) and re.fullmatch(r'[a-z_./=:\-]+', s) and NAMEISH_WORDS.search(s):
        return True                              # setting names strung together: /secret=/api_key=
    return False

def looks_secret(v, min_len):
    """A literal that could plausibly be a real credential."""
    if len(v) < min_len or is_placeholder(v):
        return False
    has_digit = any(c.isdigit() for c in v)
    has_alpha = any(c.isalpha() for c in v)
    has_sym = any((not c.isalnum()) for c in v)
    if not has_alpha and not has_sym:            # only digits: an id, a number
        return False
    if re.fullmatch(r'[A-Za-z]+', v):            # a plain word or CamelCase name
        return False
    if re.fullmatch(r'[A-Za-z_.\-]+', v) and not re.search(r'[A-Z].*[a-z].*[A-Z]|[a-z][A-Z][a-z]*[A-Z]', v):
        return False                             # word_with_separators
    return (has_digit and has_alpha) or (has_sym and has_alpha and len(v) >= 12)

HEX_ONLY = re.compile(r'[0-9a-f]+|[0-9A-F]+')

def ascending_run(v, n=8):
    """0123456789, abcdefgh: a test pattern, not a key."""
    run = 1
    for a, b in zip(v, v[1:]):
        run = run + 1 if ord(b) - ord(a) == 1 else 1
        if run >= n:
            return True
    return False

def identifier_like(v):
    """Names strung together with separators: reader_v2_font_size_2024, synthesize-1760284800000."""
    parts = [p for p in re.split(r'[_\-.:/#@]+', v) if p]
    if len(parts) < 2:
        return False
    wordish = sum(len(p) for p in parts       # words, and plain numbers such as a timestamp
                  if re.fullmatch(r'[a-z]{2,}\d{0,4}|[A-Z]{2,}\d{0,4}|[A-Z][a-z]+\d{0,4}|v?\d+', p))
    return wordish >= sum(len(p) for p in parts) * 0.6

def random_looking(v, min_len=32):
    if len(v) < min_len or is_placeholder(v):
        return False
    if not re.fullmatch(r'[A-Za-z0-9+/=_\-.~!@#$%^&*]+', v):
        return False
    if not any(c.isalpha() for c in v):
        return False
    if ascending_run(v):
        return False
    e = entropy(v)
    n = len(v)
    if HEX_ONLY.fullmatch(v):
        # Hex has only 16 symbols, so a truly random hex key scores well below a
        # mixed-case one of the same length: judge it against random hex.
        if not any(c.isdigit() for c in v):
            return False
        return e >= (2.9 if n >= 32 else 2.5)
    if identifier_like(v):
        return False
    digits = sum(c.isdigit() for c in v)
    if digits >= max(3, n // 16):
        return e >= (3.5 if n >= 24 else 3.3)
    # Few or no digits: a random mixed-case token still has a very even spread of
    # characters, while long names and identifiers (camelCase, snake_case) do not.
    if not (any(c.isupper() for c in v) and any(c.islower() for c in v)):
        return False
    wordy = sum(len(w) for w in re.findall(r'[A-Z]?[a-z]{3,}', v))
    if wordy >= n * 0.5:
        return False
    return e >= min(4.4, math.log(n, 2) - 0.85)

SALT_WORDS = re.compile(r'(?i)(your|unique phrase|example|sample|changeme|change me|replace|placeholder|dummy|fake|xxxx|put |here|todo)')

def php_secret_value(v):
    """A define()/const literal of 20+ characters that could be a real secret.
    WordPress salts can contain spaces and <>{} so they get their own test."""
    if len(v) < 20:
        return False
    if looks_secret(v, 20) and entropy(v) >= 3.0:
        return True
    if SALT_WORDS.search(v):
        return False
    words = re.findall(r'[A-Za-z]{3,}', v)
    if len(words) >= 3 and sum(len(w) for w in words) >= len(v) * 0.6:
        return False                             # a sentence
    classes = sum(bool(re.search(rx, v)) for rx in (r'[a-z]', r'[A-Z]', r'\d', r'[^\w\s]'))
    return classes >= 3 and entropy(v) >= 4.2

QUOTED = re.compile(r"'((?:[^'\\\n]|\\.)*)'|\"((?:[^\"\\\n]|\\.)*)\"|`((?:[^`\\\n]|\\.)*)`")

def quoted_literals(line):
    for m in QUOTED.finditer(line):
        g = m.group(1) if m.group(1) is not None else (m.group(2) if m.group(2) is not None else m.group(3))
        yield g

CONFIG_EXT = {'.env', '.properties', '.ini', '.cfg', '.conf', '.toml', '.yml', '.yaml', '.sh',
              '.bash', '.zsh', '.txt', '.md', '.netrc', '.xcconfig', '.htaccess', ''}

BACKUP_SUFFIX = re.compile(r'(?:\.(?:bak|backup|orig|old|save|saved|copy|tmp|swp|prev|\d+)|~)+$', re.I)

def ext_of(path):
    base = BACKUP_SUFFIX.sub('', os.path.basename(path)) or os.path.basename(path)
    if base.startswith('.env'):
        return '.env'
    root, ext = os.path.splitext(base)
    if not ext and base.startswith('.'):
        return base
    return ext.lower()

# ---------------------------------------------------------------- rules
TOKEN_RULES = [
    ('private_key', re.compile(r'-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----')),
    ('aws_key',     re.compile(r'(?<![A-Z0-9])(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}(?![0-9A-Z])')),
    ('google_key',  re.compile(r'(?<![\w-])AIza[0-9A-Za-z_\-]{35}(?![\w-])')),
    ('google_oauth', re.compile(r'(?<![\w-])(?:GOCSPX-[0-9A-Za-z_\-]{20,}|ya29\.[0-9A-Za-z_\-]{20,}|1//0[0-9A-Za-z_\-]{30,})')),
    ('stripe_key',  re.compile(r'(?<![\w])(?:sk|rk)_(?:live|test)_[0-9A-Za-z]{16,}|(?<![\w])whsec_[0-9A-Za-z]{20,}')),
    ('github_token', re.compile(r'(?<![\w])(?:gh[pousr]_[0-9A-Za-z]{36,}|github_pat_[0-9A-Za-z_]{40,})')),
    ('slack_token', re.compile(r'(?<![\w])xox[abposr]-[0-9A-Za-z\-]{10,}|hooks\.slack\.com/services/T[0-9A-Z]{6,}/B[0-9A-Z]{6,}/[0-9A-Za-z]{20,}')),
